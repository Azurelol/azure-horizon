{
  "name": "azure-horizon",
  "version": "1.0.0",
  "description": "Azure Horizon",
  "main": "index.js",
  "scripts": {
    "prettier": "prettier --write .",
    "build": "rollup -c",
    "createSymlinks": "node ./tools/create-symlinks.mjs",
    "postinstall": "npm run createSymlinks",
    "pullJSONtoLDB": "node ./tools/pullJSONtoLDB.mjs",
    "pushLDBtoJSON": "node ./tools/pushLDBtoJSON.mjs",
    "unpack": "npm run pushLDBtoJSON",
    "pack": "npm run pullJSONtoLDB",
    "lint": "eslint system.mjs src/module/**/* templates/**/*",
    "lint:fix": "eslint --fix system.mjs src/module/**/* templates/**/*"
  },
  "repository": {
    "type": "git",
    "url": "ghttps://github.com/Azurelol/azure-horizon.git"
  },
  "keywords": [
    "fvtt",
    "system"
  ],
  "author": "Christian Sagel",
  "bugs": {
    "url": "https://github.com/Azurelol/azure-horizon/issues"
  },
  "homepage": "https://github.com/Azurelol/azure-horizon#readme",
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@foundryvtt/foundryvtt-cli": "^3.0.0",
    "@html-eslint/eslint-plugin": "^0.26.0",
    "@html-eslint/parser": "^0.26.0",
    "@stylistic/eslint-plugin": "^5.5.0",
    "eslint": "^9.27.0",
    "eslint-plugin-jsdoc": "^51.4.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "prettier": "3.8.3",
    "rollup": "^4.9.1",
    "showdown": "^2.1.0"
  }
