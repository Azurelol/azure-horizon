    {
      "sort": 1600000,
      "name": "Free Attack",
      "type": "text",
      "_id": "exaOot3GG3KwAcS8",
      "system": {},
      "title": {
        "show": true,
        "level": 1
      },
      "image": {},
      "text": {
        "format": 1,
        "content": "<p>An attack with this descriptor requires no check and always does a fixed amount of damage based on the attacker's weapon or attack.</p>"
      },
      "video": {
