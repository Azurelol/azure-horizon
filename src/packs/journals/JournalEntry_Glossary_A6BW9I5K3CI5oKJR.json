    {
      "sort": 1500000,
      "name": "Exhaust",
      "type": "text",
      "_id": "gCzxcLlBTwQgOAyC",
      "system": {},
      "title": {
        "show": true,
        "level": 1
      },
      "image": {},
      "text": {
        "format": 1,
        "content": "<p>An action with this trait can only be used once per battle.</p>"
      },
