{
  "id": "azure-horizon",
  "title": "Azure Horizon",
  "description": "The Azure Horizon System for FoundryVTT.",
  "authors": [
    {
      "name": "Christian Sagel",
      "discord": "azurelol"
    }
  ],
  "url": "https://github.com/Azurelol/azure-horizon",
  "license": "LICENSE.txt",
  "readme": "README.md",
  "bugs": "https://github.com/Azurelol/azure-horizon/issues",
  "changelog": "CHANGELOG.md",
  "media": [
    {
      "type": "setup",
      "url": "",
      "thumbnail": ""
    }
  ],
  "version": "AUTOMATIC",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "esmodules": ["system.mjs"],
  "styles": ["system.css"],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "de",
      "name": "Deutsch (German)",
      "path": "lang/de.json"
    }
  ],
  "packs": [
    {
      "name": "classes",
      "label": "AH.COMPENDIUM.classes",
      "type": "Item"
    },
    {
      "name": "equipment",
      "label": "AH.COMPENDIUM.equipment",
      "type": "Item"
    },
    {
      "name": "spells",
      "label": "AH.COMPENDIUM.spells",
      "type": "Item"
    },
    {
      "name": "effects",
      "label": "AH.COMPENDIUM.effects",
      "type": "ActiveEffect"
    },
    {
      "name": "journals",
      "label": "AH.COMPENDIUM.journals",
      "type": "JournalEntry"
    },
    {
      "name": "tables",
      "label": "AH.COMPENDIUM.tables",
      "type": "RollTable"
    },
    {
      "name": "assembly",
      "label": "AH.COMPENDIUM.assembly",
      "type": "Item"
    },
    {
      "name": "heroes",
      "label": "AH.COMPENDIUM.heroes",
      "type": "Actor"
    },
    {
      "name": "adversaries",
      "label": "AH.COMPENDIUM.adversaries",
      "type": "Actor"
    }

  ],
  "packFolders": [
    {
      "name": "Azure Horizon System",
      "color": "#3d598b",
      "packs": ["classes", "equipment", "spells", "effects", "journals", "tables", "assembly", "adversaries", "heroes" ]
    }
  ],
  "manifest": "https://github.com/Azurelol/azure-horizon/releases/latest/download/system.json",
  "download": "AUTOMATIC",
  "background": "",
  "primaryTokenAttribute": "resources.hp",
  "documentTypes": {
    "Actor": {
      "hero": {},
      "adversary": {},
      "party": {},
      "follower": {},
      "entity": {},
      "unit": {}
    },
    "Item": {
      "weapon": {},
      "armor": {},
      "accessory": {},
      "engram": {},
      "spell": {},
      "class": {},
      "skill": {},
      "classFeature": {},
      "consumable": {},
      "attack": {},
      "ability": {},
      "move": {}
    }
  },
  "flags": {
    "hotReload": {
      "extensions": ["css", "html", "hbs", "json"],
      "paths": ["src/styles", "templates", "lang"]
    }
  }
}
