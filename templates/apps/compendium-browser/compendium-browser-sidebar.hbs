<aside class="ah-application__sidebar">
	<section>
		<label>
			<input
			 id="search"
			 type="search"
			 name="search"
			 value="{{filter.text}}"
			 placeholder="Search…"
			 autocomplete="off"/>
		</label>
	</section>
	{{#each filter.categories as |cat id|}}
		<fieldset>
			<legend>
				<label>
					<i class="fa fa-filter"></i>
					{{localize cat.label}}
				</label>
			</legend>
			<div class="ah-application__sidebar__filter">
				{{#each cat.options as |opt|}}
					<label class="ah-filter-option">
						<input type="checkbox"
							   data-category="{{id}}"
							   data-option="{{opt.value}}"
							   {{#if (ahContains ../selected opt.value)}}checked{{/if}}
						/>
						{{localize opt.label}}
					</label>
				{{/each}}
			</div>
		</fieldset>
	{{/each}}
</aside>
