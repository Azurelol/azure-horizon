<div class="ah-hud__docked__frame">

  <header class="ah-hud__docked__header">
    {{ahRing img=actor.img tooltip=actor.name name=actor.name size='m' background=backgroundClass}}
  </header>

  <nav class="ah-hud__docked__groups">
    {{#each groups}}
      <section class="ah-hud__group {{#if open}}ah-hud__group--open{{/if}}" data-group-id="{{id}}">
        <button type="button" class="ah-hud__group-button"
                data-tooltip="{{localize label}}"
                data-action="toggleGroup" data-group-id="{{id}}">
          <i class="ah-icon --m {{ahIconClass (ahDefault icon id)}}"></i>
        </button>

        <div class="ah-hud__actions --above">
          {{#each actions}}
            <button type="button" class="ah-hud__action" data-action="useAction" data-action-id="{{id}}" data-tooltip="{{tooltip}}">
              {{#if img}}<img class="ah-hud__action-img" src="{{img}}" alt="" loading="lazy">{{/if}}
              <span class="ah-hud__action-name">{{name}}</span>
            </button>
          {{/each}}
        </div>
      </section>
    {{/each}}
  </nav>

</div>




