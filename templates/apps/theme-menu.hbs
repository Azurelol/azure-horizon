<section class="ah-menu">
  <header>
    <div class="form-group">
      <label for="theme" class="fu-form__property">
        {{localize "AH.COMMON.Theme"}}
        <select name="theme" data-action="changeTheme">
          <option value="">{{localize "AH.COMMON.Custom"}}</option>
          {{#each themes}}
            <option value="{{@key}}">{{localize (concat "AH.THEMES." @key)}}</option>
          {{/each}}
        </select>
      </label>
    </div>
    <div class="form-group buttons">
      <button type="button" data-action="importTheme" name="import">
        <i class="fas fa-file-import"></i>{{localize "AH.COMMON.Import"}}
      </button>
      <button type="button" data-action="exportTheme" name="export">
        <i class="fas fa-file-export"></i>{{localize "AH.COMMON.Export"}}
      </button>
    </div>
  </header>
  <main>
    <div class="ah-field-group">
      {{#each fields}}
        {{#if (eq this.type "multiline-text")}}
          <label class="ah-field" data-tooltip="{{localize hint}}">
            <span>{{localize label}}</span>
            <textarea name="{{@key}}" rows="5">{{lookup ../current @key}}</textarea>
          </label>
        {{else}}
          <label class="ah-field" data-tooltip="{{localize hint}}">
            <span>{{localize label}}</span>
            {{#if (eq this.type "color")}}
              <input type="color" name="{{@key}}" value="{{lookup ../current @key}}">
            {{else if (eq this.type "image")}}
              <input type="text" name="{{@key}}" value="{{lookup ../current @key}}">
              <button
                type="button"
                data-action="filePicker"
                data-target="{{@key}}"
                data-type="image"
                title="Browse Files">
                <i class="fas fa-file-import"></i>
              </button>
            {{else}}
              <input type="text" name="{{@key}}" value="{{lookup ../current @key}}">
            {{/if}}
          </label>
        {{/if}}
      {{/each}}
    </div>
  </main>
  <footer>
    <div class="flexrow flex-group-center">
      <button type="button" name="apply" data-action="applyTheme">
        <i class="fas fa-palette"></i>{{localize "AH.COMMON.Preview"}}
      </button>
      <button type="submit" name="submit" data-action="saveTheme">
        <i class="fas fa-floppy-disk"></i>{{localize "AH.COMMON.Save"}}
      </button>
      <button type="reset" name="reset">
        <i class="fas fa-undo"></i>{{localize "AH.COMMON.Reset"}}
      </button>
    </div>
  </footer>
</section>
