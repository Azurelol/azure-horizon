<section class="ah-chat-section">
  <span>
    {{{localize message actor=actor damage=damage amount=amount from=from resource=resource}}}.
  </span>

  <div class="ah-chat-section__damage__box">
    {{#each result.instances}}
      <label data-tooltip="{{localize (ahLocaleKey 'damageTypes' type)}}">
        <i class="ah-icon --xs {{ahIconClass type}}"></i>
        <span>{{amount}}</span>
      </label>
    {{/each}}
  </div>

  {{#each content as |section|}}
    <article>
      {{{section}}}
    </article>
  {{/each}}

  <div class="ah-chat-section__damage__actions">
    <a data-action="revertDamage" data-uuid="{{uuid}}"
       data-amount="{{amount}}" data-resource="{{resource}}"
       data-tooltip="{{localize 'FU.ChatRevertDamage'}}">
      <span>
        <i class="ah-icon --xs --light {{ahIconClass 'undo'}}"></i>
      </span>
    </a>
  </div>

</section>
