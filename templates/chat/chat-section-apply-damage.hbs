<section class="ah-chat-section">
  <span>
    {{{localize message actor=actor damage=damage amount=amount from=from resource=resource}}}
  </span>

  {{#if pressure.valid}}
    <div class="ah-flex-center">
      <span>{{{ localize 'AH.CHAT.DamagePressure' reason=pressure.message}}}</span>
      {{ahResourceBar '' pressure.resource.value pressure.resource.max tooltip='AH.CHARACTER.PressurePoint.long' colorClass="--ah-color-pp" }}
    </div>
  {{/if}}

  {{#if amountBlocked}}
    <span>
      {{{ localize 'AH.CHAT.DamagePartialBlock' amount=amountBlocked}}}
    </span>
  {{/if}}

  {{#each content as |section|}}
    <article>
      {{{section}}}
    </article>
  {{/each}}

  <div class="ah-chat-section__damage__box">
    {{#each result.instances}}
      <label data-tooltip="{{localize (ahLocaleKey 'damageTypes' type)}}">
        <i class="ah-icon --xs {{ahIconClass type}}"></i>
        <span>{{amount}}</span>
      </label>
    {{/each}}
  </div>

  <div class="ah-chat-section__damage__actions">
    <a data-action="revertDamage" data-uuid="{{uuid}}"
       data-amount="{{amount}}" data-resource="{{resource}}"
       data-tooltip="{{localize 'AH.COMMON.Revert'}}">
      <span>
        <i class="ah-icon --xs {{ahIconClass 'undo'}}"></i>
      </span>
    </a>
  </div>

</section>
