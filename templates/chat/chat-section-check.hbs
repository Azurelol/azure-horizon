<section class="ah-chat-section">

  <div class="ah-chat-section__check__details">

    <div class="ah-chat-section__check__details__group">
      {{#if result.data.targetedDefense}}
        <div class="ah-chat-section__check__total">
          <i class="ah-icon --s {{ahIconClass 'target'}}"></i>
          <span>{{localize 'AH.CHECK.TargetDefense' result=result.total defense=(ahUpperCase result.data.targetedDefense)}}</span>
        </div>

      {{else}}
        {{#if (gt difficulty 0)}}
          <div class="ah-chat-section__check__total" data-tooltip="{{localize 'AH.CHECK.DifficultyLevel.long'}}">
            <i class="ah-icon --s {{ahIconClass 'difficulty'}}"></i>
            <span>{{difficulty}}</span>
          </div>
        {{/if}}
      {{/if}}

      <div class='ah-chat-section__check__components'>
        <span data-tooltip="{{ahLocaleKey 'attributes' result.primary.attribute}}">
          <i class="ah-icon --s {{ahIconClass result.primary.attribute}}"></i>
          {{result.primary.result}}
        </span>
        <span data-tooltip="{{ahLocaleKey 'attributes' result.secondary.attribute}}">
          <i class="ah-icon --s {{ahIconClass result.secondary.attribute}}"></i>
          {{result.secondary.result}}
        </span>
        {{#if result.modifierTotal}}
          <span data-tooltip="{{localize 'AH.CHARACTER.Modifier.long'}}">
            <i class="ah-icon --s {{ahIconClass 'modifier'}}"></i>
            {{result.modifierTotal}}
          </span>
        {{/if}}
      </div>
    </div>
  </div>

  {{#if (or (gt difficulty 0) result.crit result.fumble)}}
    <div class='ah-chat-section__check__outcome {{ahCheckOutcome result.total difficulty}}'>
      <div class="ah-chat-section__check__outcome__number">
        <i class="{{ahIconClass (ahConcat check.type 'Check')}}"></i>
        <span>{{result.total}}</span>
      </div>
      {{#if difficulty}}
        <div class="ah-chat-section__check__outcome__text">
          {{#if result.crit}}
            <span>{{localize 'AH.CHECK.Critical'}}!</span>
          {{else if result.fumble}}
            <span>{{localize 'AH.CHECK.Fumble'}}</span>
          {{else if (gte result.total difficulty)}}
            <span>{{localize 'AH.CHECK.Success'}}</span>
          {{else}}
            <span>{{localize 'AH.CHECK.Failure'}}</span>
          {{/if}}
        </div>
      {{else}}
        {{#if (or result.crit result.fumble)}}
          <div>
            {{#if result.crit}}
              <span>{{localize 'AH.CHECK.Critical'}}!</span>
            {{else if result.fumble}}
              <span>{{localize 'AH.CHECK.Fumble'}}</span>
            {{/if}}
          </div>
        {{/if}}
      {{/if}}
    </div>
  {{/if}}

</section>


