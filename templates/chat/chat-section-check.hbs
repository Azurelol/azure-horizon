<section class="ah-chat-section">

  <details>
    <summary class="ah-chat-section__check__total">
      {{#if result.data.targetedDefense}}
        <i class="ah-icon --s {{ahIconClass 'result'}}"></i>
        <span>{{localize 'AH.CHECK.TargetDefense' result=result.total defense=(ahUpperCase result.data.targetedDefense)}}</span>
      {{else}}
        {{#if (gt difficultyLevel 0)}}
          <i class="ah-icon --s {{ahIconClass 'difficulty'}}"></i>
          <span>{{difficultyLevel}}</span>
        {{/if}}
      {{/if}}
    </summary>

    <div class="ah-chat-section__check__details__group">
      <div class='ah-chat-section__check__components'>
        {{ahInlineProperty 'attributes' result.primary.attribute value=result.primary.result }}
        {{ahInlineProperty 'attributes' result.secondary.attribute value=result.secondary.result }}
        {{#if result.modifierTotal}}
          {{ahInlineProperty 'icons' 'modifier' value=result.modifierTotal tooltip='AH.CHARACTER.Modifier.long' }}
        {{/if}}
      </div>
    </div>

  </details>

  {{#if (or (gt difficultyLevel 0) result.crit result.fumble)}}
      <div class='ah-chat-section__check__outcome {{outcome}}'>
        <div class="ah-chat-section__check__outcome__number">
          <i class="{{ahIconClass (ahConcat check.type 'Check')}}"></i>
          <span>{{result.total}}</span>
        </div>
        {{#if difficultyLevel}}
          <div class="ah-chat-section__check__outcome__text">
            {{#if (eq outcome 'critical')}}
              <span>{{localize 'AH.CHECK.Critical'}}!</span>
            {{else if (eq outcome 'fumble')}}
              <span>{{localize 'AH.CHECK.Fumble'}}</span>
            {{else if (eq outcome 'success')}}
              <span>{{localize 'AH.CHECK.Success'}}</span>
            {{else}}
              <span>{{localize 'AH.CHECK.Partial'}}</span>
            {{/if}}
          </div>
        {{else}}
          {{#if (or result.crit result.fumble)}}
            <div>
              {{#if result.crit}}
                <span>{{localize 'AH.CHECK.Critical'}}!</span>
              {{else if result.fumble}}
                <span>{{localize 'AH.CHECK.Fumble'}}</span>
              {{/if}}
            </div>
          {{/if}}
        {{/if}}
      </div>
  {{/if}}

</section>


