<section class="ah-chat-section__check">

  <div class="ah-chat-section__check__details">
    <div class="ah-chat-section__check__details__group">
      {{#if result.data.targetedDefense}}
        <div class="ah-chat-section__check__total">
          <i class="ah-icon --s {{ahIconClass 'target'}}"></i>
          <span>{{localize 'AH.CHECK.TargetDefense' result=result.total defense=(ahUpperCase result.data.targetedDefense)}}</span>
        </div>
      {{/if}}

      <div class='ah-chat-section__check__components'>
        <div>
          {{ahBadge icon=(ahIconClass result.primary.attribute) label=(ahLocaleKey 'attributes' result.primary.attribute format='short') value=result.primary.result}}
        </div>
        <div>
          {{ahBadge icon=(ahIconClass result.secondary.attribute) label=(ahLocaleKey 'attributes' result.secondary.attribute format='short') value=result.secondary.result}}
        </div>
        <div>
          {{ahBadge iconClass='modifier' label='AH.CHARACTER.Modifier.short' value=result.modifierTotal }}
        </div>
        {{#if (gt difficulty 0)}}
          <div>
            {{ahBadge iconClass='difficulty' label='AH.CHECK.DifficultyLevel.short' size='m' tooltip='AH.CHECK.DifficultyLevel.long' value=difficulty }}
          </div>
        {{/if}}
      </div>
    </div>

    {{#if result.data.damage}}
      <div class="ah-chat-section__check__details__group">
        <div class="ah-chat-section__check__total --damage">
          <i class="ah-icon --s {{ahIconClass 'damage'}}"></i>
          <span>{{result.data.damage.total}}</span>
        </div>

        <div class='ah-chat-section__check__components'>
          <div>
            {{ahBadge iconClass='hr' label='AH.CHECK.HighRoll.short' size='s' tooltip='AH.CHECK.HighRoll.long' value=result.hr.result }}
          </div>
          <div>
            {{ahBadge iconClass='modifier' label='AH.CHECK.Modifier.short' size='s' tooltip='AH.CHECK.HighRoll.long' value=result.damage.modifierTotal }}
          </div>
        </div>
      </div>
    {{/if}}
  </div>

  {{#if (or (gt difficulty 0) result.crit result.fumble)}}
    <div class='ah-chat-section__check__outcome {{ahCheckOutcome result.total difficulty}}'>
      <div class="ah-chat-section__check__outcome__number">
        <i class="{{ahIconClass (ahConcat check.type 'Check')}}"></i>
        <span>{{result.total}}</span>
      </div>
      {{#if difficulty}}
        <div class="ah-chat-section__check__outcome__text">
          {{#if result.crit}}
            <span>{{localize 'AH.CHECK.Critical'}}!</span>
          {{else if result.fumble}}
            <span>{{localize 'AH.CHECK.Fumble'}}</span>
          {{else if (gte result.total difficulty)}}
            <span>{{localize 'AH.CHECK.Success'}}</span>
          {{else}}
            <span>{{localize 'AH.CHECK.Failure'}}</span>
          {{/if}}
        </div>
      {{else}}
        {{#if (or result.crit result.fumble)}}
          <div>
            {{#if result.crit}}
              <span>{{localize 'AH.CHECK.Critical'}}!</span>
            {{else if result.fumble}}
              <span>{{localize 'AH.CHECK.Fumble'}}</span>
            {{/if}}
          </div>
        {{/if}}
      {{/if}}
    </div>
  {{/if}}
</section>


