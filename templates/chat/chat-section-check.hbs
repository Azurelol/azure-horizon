<section class="ah-chat-section__check">

  <dl class='ah-chat-section__check__inputs'>
    <div>
      <dt>{{result.primary.attribute}}</dt>
      <dd>{{ahBadge icon=(ahIconClass result.primary.attribute) label=(ahLocaleKey 'attributes' result.primary.attribute format='short') value=result.primary.result}}</dd>
    </div>
    <div>
      <dt>{{result.secondary.attribute}}</dt>
      <dd>{{ahBadge icon=(ahIconClass result.secondary.attribute) label=(ahLocaleKey 'attributes' result.secondary.attribute format='short') value=result.secondary.result}}</dd>
    </div>
    <div {{#if modifiers}}data-tooltip="{{#each modifiers}}{{localize label}}: {{value}}{{#unless @last}}<br>{{/unless}}{{/each}}"{{/if}}>
      <dt>{{localize 'AH.CHARACTER.Modifier.short'}}</dt>
      <dd>{{ahBadge iconClass='modifier' label='AH.CHARACTER.Modifier.short'}} <span>{{#unless (lt result.modifier 0)}}+{{/unless}}{{result.modifier}}</span></dd>
    </div>
  </dl>
  {{#if (gt difficulty 0)}}
    <div class="ah-chat-section__roll__difficulty">
      <div>
        {{ahBadge iconClass='difficulty' label='AH.CHECK.DifficultyLevel.short' size='l' tooltip='AH.CHECK.DifficultyLevel.long' }}
        <label>{{difficulty}}</label>
      </div>
    </div>
  {{/if}}

  {{#if (or (gt difficulty 0) result.crit result.fumble)}}
    <div class='ah-chat-section__check__outcome {{ahCheckOutcome result difficulty}}'>
      <div class="ah-chat-section__check__outcome__number">
        <img class="{{ahIconClass check.type}}" alt="dice"/>
        <span>{{result.total}}</span>
      </div>
      {{#if difficulty}}
        <div class="ah-chat-section__check__outcome__text">
          {{#if result.crit}}
            <span>{{localize 'AH.CHECK.Critical'}}!</span>
          {{else if result.fumble}}
            <span>{{localize 'AH.CHECK.Fumble'}}</span>
          {{else if (gte result.total difficulty)}}
            <span>{{localize 'AH.CHECK.Success'}}</span>
          {{else}}
            <span>{{localize 'AH.CHECK.Failure'}}</span>
          {{/if}}
        </div>
      {{else}}
        {{#if (or result.crit result.fumble)}}
          <div>
            {{#if result.crit}}
              <span>{{localize 'AH.CHECK.Critical'}}!</span>
            {{else if result.fumble}}
              <span>{{localize 'AH.CHECK.Fumble'}}</span>
            {{/if}}
          </div>
        {{/if}}
      {{/if}}
    </div>
  {{/if}}
</section>


