<section class="ah-chat-section">
  <div class="ah-chat-section__check__details__group">
    <div class="ah-chat-section__check__total --damage">
      <i class="ah-icon --s {{ahIconClass 'damage'}}"></i>
      <span>{{localize 'AH.CHECK.TargetResource' result=damage.resolved.total resource='HP'}}</span>
    </div>

    <div class='ah-chat-section__check__components'>
      {{#each damage.instances as |component|}}
        <div class="ah-chat-section__damage__component"
              data-tooltip="{{localize component.label}}">
          {{ahInlineProperty 'damageTypes' component.type }}
          <div class="ah-chat-section__damage__component__value ah-inline-property__value">
            {{#each component.addends as |addend|}}
              <span class="ah-chat-section__damage__addend">
                {{numberFormat addend decimals=0 sign=true}}
              </span>
            {{/each}}
            {{#each component.modifiers as |mod|}}
              <span class="ah-chat-section__damage__modifier --{{mod.key}}">
              {{#if mod.additive}}
                <span class="ah-chat-section__check__components__additive">{{numberFormat mod.additive decimals=0 sign=true}}</span>
              {{/if}}
                {{#if (ne mod.multiplicative 1)}}
                  <span class="ah-chat-section__check__components__multiplicative">{{ahPercentModifier mod.multiplicative}}</span>
                {{/if}}
            </span>
            {{/each}}
          </div>
        </div>
      {{/each}}

    </div>
  </div>
</section>
