<table class="ah-potency-table">
  <tbody>

  <tr class="ah-potency-table__row --reduced">
    <td class="ah-potency-table__tier">
      <i class="ah-icon --xs {{ahIconClass 'reduced'}}" data-tooltip="{{localize "AH.ACTION.POTENCY.Reduced"}}"></i>
    </td>
    <td class="ah-potency-table__components">
      {{#each potencies.reduced.components as |component|}}
        {{#each component.actions}}
          {{> 'systems/azure-horizon/templates/components/partials/chat-action.hbs' classes="--compact" text=component.text}}
        {{/each}}
      {{/each}}
    </td>
  </tr>

  <tr class="ah-potency-table__row --standard">
    <td class="ah-potency-table__tier">
      <i class="ah-icon --xs {{ahIconClass 'standard'}}" data-tooltip="{{localize "AH.ACTION.POTENCY.Standard"}}"></i>
    </td>
    <td class="ah-potency-table__components">
      {{#each potencies.standard.components as |component|}}
        {{#each component.actions}}
          {{> 'systems/azure-horizon/templates/components/partials/chat-action.hbs' classes="--compact" text=component.text}}
        {{/each}}
      {{/each}}
    </td>
  </tr>

  <tr class="ah-potency-table__row --powerful">
    <td class="ah-potency-table__tier">
      <i class="ah-icon --xs {{ahIconClass 'powerful'}}" data-tooltip="{{localize "AH.ACTION.POTENCY.Powerful"}}"></i>
    </td>
    <td class="ah-potency-table__components">
      {{#each potencies.powerful.components as |component|}}
        {{#each component.actions}}
          {{> 'systems/azure-horizon/templates/components/partials/chat-action.hbs' classes="--compact" text=component.text}}
        {{/each}}
      {{/each}}
    </td>
  </tr>
  </tbody>
</table>
