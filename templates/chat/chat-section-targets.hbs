{{#if targets}}
  <section class="ah-chat-section__targets">
    {{#each targets as |target|}}
      <div class="ah-chat-section__target {{target.potency}}">
        <!-- Info -->
        <div class="ah-chat-section__target__info">
          {{ahDocumentAnchor target}}
          <span class="ah-chat-section__target__name">
            {{ahAcronym target.name 14}}
          </span>
        </div>
        <!-- Defense -->
        <span class="ah-chat-section__defense">
          <i class="ah-icon --xs {{ahIconClass 'targetDefense'}}"></i>
          {{target.difficulty}}
        </span>
        <!-- Potency -->
        <span class="ah-chat-section__potency">
          {{localize (ahLocaleKey 'potencies' target.potency)}}
        </span>
        <!-- Actions -->
        <div class="ah-chat-section__target__actions">
          {{#each ../actions as |action|}}
            {{#if targeted}}
              {{#unless (and (ahNotEmpty action.dataset.potency) (ahNotEquals action.dataset.potency target.potency)) }}
                {{> 'systems/azure-horizon/templates/components/partials/chat-action-targeted.hbs' target=target }}
              {{/unless}}
            {{/if}}
          {{/each}}
        </div>
      </div>
    {{/each}}
  </section>
{{/if}}
