<div class="ah-field --stack" style="gap: 0;">
  <div class="ah-field__header">
    <span>{{localize label}}</span>
    <a data-tooltip="{{localize 'AH.COMMON.Add'}}"
       data-path="{{path}}"
       data-action="addArrayElement">
      <i class="ah-icon--xs {{ahIconClass 'add'}}">
      </i>
    </a>
  </div>
  <div class="ah-field__array">
    {{#each array as |entry index|}}
      <div class="ah-field__array__element">
        <label class="ah-field__array__element__input">
          {{#if ../options}}
            {{ahAutoComplete name=(ahConcat ../path "." index) value=entry placeholder="..." options=../options}}
          {{else if (eq ../type 'string')}}
            <input type="text"
                   name="{{ahConcat ../path '.' index}}"
                   value="{{entry}}"
                   placeholder="..." />
          {{/if}}
        </label>
        <a data-path="{{../path}}" data-index="{{ index }}" data-action="removeArrayElement">
          <i class="ah-icon--xs {{ahIconClass 'remove'}}"></i>
        </a>
      </div>
    {{/each}}
  </div>
</div>

