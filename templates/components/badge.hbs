<label class="ah-badge {{classes}}">
  <div class="ah-badge__label">
    <i class="ah-icon --{{size}} {{iconClasses}} {{icon}}"></i>
    <span>{{ localize label }}</span>
  </div>
  {{#if path}}
    {{#if (eq type 'number')}}
      <input type="number" name="{{path}}" value="{{ value }}" min="{{min}}" max="{{max}}">
    {{/if}}
  {{else}}
    <input disabled value="{{ value }}">
  {{/if}}
</label>
