<a data-link draggable="true"
   data-uuid="{{uuid}}"
   data-item-id="{{id}}"
   data-pack="{{pack}}"
   class="{{classes}}"
   data-type="{{type}}" data-tooltip="{{name}}">
  {{#if img}}
    <img src="{{img}}" class="item-img ah-icon --{{size}}" alt="{{name}}">
  {{else}}
    <i class="item-img ah-icon --{{size}} {{ahIconClass 'compendium'}}"></i>
  {{/if}}
</a>
