<fieldset id="{{ahDefault id (localize label)}}" class="ah-fieldset --grid --optional {{class}}">
  <legend class="{{#if enabled}}active{{else}}inactive{{/if}}">
    <label>
      {{#if icon}}<i class="ah-icon --s {{icon}}"></i>{{/if}}
      {{localize label}}
      <input type="checkbox"
             name="{{name}}"
             {{#if enabled}}checked{{/if}}>
    </label>
  </legend>
  <div class="{{#unless enabled}}inactive{{/unless}}">
    {{> @partial-block}}
  </div>
</fieldset>
