<label class="ah-field" data-tooltip="{{tooltip}}" style="{{style}}">
  {{#if label}}
    <span>{{localize label}}</span>
  {{/if}}
  {{#if icon}}
    <i class="ah-icon --xs {{icon}}"></i>
  {{/if}}
  {{#if range}}
    <input type="range"
           name="{{path}}"
           style="margin: 0 1rem 0 1rem"
           min="{{min}}" max="{{max}}" step="1"
           value="{{value}}" />
    <output for="{{path}}">{{value}}</output>
  {{else}}
    <input
      type="number"
      name="{{path}}"
      value="{{value}}"/>
  {{/if}}

</label>
