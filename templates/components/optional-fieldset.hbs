<fieldset class="ah-fieldset {{class}}">
  <legend class="{{#if enabled}}enabled{{else}}disabled{{/if}}">
    <label style="cursor:pointer;">
      {{#if icon}}<i class="ah-icon --s {{icon}}"></i>{{/if}}
      {{localize label}}
      <input type="checkbox"
             name="{{name}}"
             hidden
             {{#if enabled}}checked{{/if}}>
    </label>
  </legend>

  <div class="{{#unless enabled}}disabled{{/unless}}">
    {{> @partial-block}}
  </div>
</fieldset>
