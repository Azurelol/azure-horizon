<div class="ah-resource-bar">
  <!--Label-->
  <div class="ah-resource-bar__label" data-tooltip="{{localize tooltip}}">
    <i class="{{icon}}"></i>
    <span>{{localize label}}</span>
  </div>
  <!--Bar-->
  <div class="ah-resource-bar__control" data-path="{{path}}" data-current="{{value}}" data-max="{{max}}">
    <div class="ah-resource-bar__control__fill" style="width: {{ahPercentage value max}}; --ah-resource-bar-color: {{color}};"></div>
    <span class="ah-resource-bar__control__value">{{value}} / {{max}}</span>
    <input class="ah-resource-bar__control__input" type="text" inputmode="numeric" name="{{path}}" value="{{value}}" />
  </div>
</div>
