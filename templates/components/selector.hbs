<label class="ah-selector {{classes}}">
  <span class="ah-selector__label">{{localize label}}</span>
  <i class="ah-icon --{{size}} {{iconClasses}} {{icon}}"></i>
  <select name="{{path}}">
    {{selectOptions values selected=value localize=true}}
  </select>
  {{#if bonus}}
    <span class="bonus">{{numberFormat bonus sign=true}}</span>
  {{/if}}
</label>
