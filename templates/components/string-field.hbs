<label class="ah-field">
  <span>{{localize label}}</span>
  {{#if options}}
    <select name="{{path}}">
      {{#if blank}}
        <option value="">-</option>
      {{/if}}
      {{selectOptions options selected=value localize=true}}
    </select>
  {{else}}
    <input
      type="text"
      name="{{path}}"
      value="{{value}}"
      placeholder="{{placeholder}}"
    />
  {{/if}}
</label>
