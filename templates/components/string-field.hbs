<label class="ah-field" data-tooltip="{{tooltip}}">
  {{#if label}}
    <span>{{localize label}}</span>
  {{/if}}
  {{#if icon}}
    <i class="ah-icon --xs {{icon}}"></i>
  {{/if}}
  {{#if options}}
    <select name="{{path}}">
      {{#if blank}}
        <option value="">-</option>
      {{/if}}
      {{selectOptions options selected=value localize=true}}
    </select>
  {{else}}
    <input
      type="text"
      name="{{path}}"
      value="{{value}}"
      placeholder="{{placeholder}}"
    />
  {{/if}}
</label>
