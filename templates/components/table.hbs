<table id="{{config.id}}" class="ah-table {{config.cssClass}}" data-table-id="{{config.id}}">
  {{#if config.title}}
    <caption class="ah-table__caption">
      <span>
        {{localize config.title}}
        {{#if config.actions}}
          {{#each config.actions}}
            {{> 'systems/azure-horizon/templates/components/partials/chat-action.hbs' classes="--transparent"}}
          {{/each}}
        {{/if}}
      </span>
    </caption>
  {{/if}}
  <thead>
    <tr>
      {{#each columns as |column|}}
        <th class="{{column.cssClass}}">
          {{lookup (lookup @root.headers @index) "text"}}
        </th>
      {{/each}}
    </tr>
  </thead>

  <tbody>
  {{#each rows as |row|}}
    <tr data-key="{{row.key}}">
      {{#each row.cells as |cell|}}
        {{{cell.template}}}
      {{/each}}
    </tr>
  {{/each}}
  </tbody>
</table>
