<td class="ah-table__column__item__cost">
  <div class="ah-table__cell --center">
    {{#if model.cost.enabled}}
      <span>
      <i class="ah-icon --s {{ahIconClass model.cost.resource}}"></i> {{model.cost.amount}}
    </span>
    {{/if}}

    {{#if model.action.enabled}}
      <span>
         <i class="ah-icon --xs {{ahIconClass model.action.type}}"></i>
        {{#if (eq model.action.type 'action') }}
          {{model.action.points}}
        {{/if}}
      </span>
    {{/if}}

    {{#if (eq model.type 'consumable')}}
      <span>
      <i class="ah-icon --s {{ahIconClass 'ip'}}"></i> {{model.cost.amount}}
    </span>
    {{/if}}
  </div>
</td>
