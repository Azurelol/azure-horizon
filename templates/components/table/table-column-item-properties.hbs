<td class="ah-table__column__item__properties">

  {{#if system.damage.enabled}}
    <span>
        <i class="ah-icon --s {{ahIconClass system.damage.primary.type}}"></i> {{system.damage.primary.amount}}
      {{#if damage.secondary.type}}
        <i class="ah-icon --s {{ahIconClass system.damage.secondary.type}}"></i> {{system.damage.secondary.amount}}
      {{/if}}

    </span>
  {{/if}}

  {{#if system.resource.enabled}}
    <span>
    <i class="ah-icon --s {{ahIconClass system.resource.type}}"></i> {{system.resource.amount}}
    </span>
  {{/if}}

  {{#if system.category}}
    <span>
      {{ahCapitalize system.category}}
    </span>
  {{/if}}
</td>
