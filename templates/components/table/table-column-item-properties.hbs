<td class="ah-table__column__item__properties">

  {{#if model.damage.enabled}}
    <span>
        <i class="ah-icon --s {{ahIconClass model.damage.primary.type}}"></i> {{ahScaleValue model.damage.primary.amount}}
      {{#if damage.secondary.type}}
        <i class="ah-icon --s {{ahIconClass model.damage.secondary.type}}"></i> {{ahScaleValue model.damage.secondary.amount}}
      {{/if}}
    </span>
  {{/if}}

  {{#if model.resource.enabled}}
    <span>
    <i class="ah-icon --s {{ahIconClass model.resource.type}}"></i> {{ahScaleValue model.resource.amount}}
    </span>
  {{/if}}

  {{#if model.category}}
    <span>
      {{ahCapitalize model.category}}
    </span>
  {{/if}}
</td>
