<td class="ah-table__column__primary">
  <div class="ah-table__cell">
    {{#if perform}}
      <a data-action="performAction" data-id="{{id}}"
        {{#if dataset}}
          {{#each dataset}}
         data-{{@key}}="{{this}}"
          {{/each}}
        {{/if}}
         data-type="{{type}}">
        <img class="ah-table-column__primary__image" src="{{img}}" alt="{{name}}"
             data-tooltip="{{localize 'AH.COMMON.Perform' name=name}}" />
      </a>
    {{else}}
      <img class="ah-table-column__primary__image" src="{{img}}" alt="{{name}}">
    {{/if}}
    <div class="ah-table-column__primary__name">
      <span class="{{cssClass}}">{{name}}</span>
    </div>
  </div>
</td>
