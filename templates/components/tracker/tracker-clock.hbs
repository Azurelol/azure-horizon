<div class="ah-tracker {{classes}}" data-item-id="{{id}}">

	<div class="ah-tracker__segments__container" data-tooltip="{{data.current}}/{{data.max}}">
		<div class="ah-tracker__segments" style="--segments: {{data.max}};" data-segments="{{data.max}}" data-index="{{index}}"
			 data-action="{{action}}"
			 data-id="{{id}}"
			 data-index="{{index}}"
			 data-update-amount="1"
			 data-alternate="true"
			 data-tooltip="{{localize 'AH.FIELD.Tracker'}}"
			 {{#if path}}data-path="{{path}}"{{/if}}>

			<div class="foreground"></div>
			{{#each arr as |obj key|}}
				<input class="pie slice{{obj.id}}" type="radio" value="{{obj.id}}" style="--index: {{obj.id}}" {{checked obj.checked}} />
				<div class="divider" style="--index: {{obj.id}}"></div>
			{{/each}}
		</div>

	</div>

	{{#if displayName}}
		<div class="ah-tracker__name__container">
			{{#if compact}}
				<a data-action="openTrackerMenu" data-id="{{id}}"
				   {{#if path}}data-path="{{path}}"{{/if}}
				   data-index="{{index}}">
					<span>{{localize displayName}}</span>
				</a>
			{{else}}
				<label>
					<span>{{localize displayName}}</span>
				</label>
			{{/if}}
		</div>
	{{/if}}

	{{#unless compact}}
		{{> 'systems/azure-horizon/templates/components/tracker/tracker-controls.hbs'}}
	{{/unless}}
</div>
