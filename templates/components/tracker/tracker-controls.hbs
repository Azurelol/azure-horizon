{{#if controls}}
	<div class="ah-tracker__controls">
		<a class="increment-button"
		   data-type="{{type}}"
		   data-id="{{id}}"
		   data-action="{{action}}"
		   data-path="{{path}}"
		   data-index="{{index}}"
		   data-update-amount="1"
		   data-tooltip="{{localize
			'AH.COMMON.Increase'}} ({{data.step}})">
			<i class="{{ahIconClass 'add'}}"></i>
		</a>
		<a class="decrement-button"
		   data-type="{{type}}"
		   data-id="{{id}}"
		   data-action="{{action}}"
		   data-path="{{path}}"
		   data-index="{{index}}"
		   data-update-amount="-1"
		   data-tooltip="{{localize
			'AH.COMMON.Decrease'}} ({{data.step}})">
      <i class="{{ahIconClass 'minus'}}"></i>
		</a>
		{{#if prompt}}
			<a data-action="promptTracker"
			   data-id="{{id}}"
			   data-path="{{path}}"
			   data-tooltip="{{localize 'AH.COMMON.Prompt'}}"
			   data-index="{{index}}">
				<i class="{{ahIconClass 'dice'}}"></i>
			</a>
		{{/if}}
		<a data-action="displayTrack"
		   data-id="{{id}}"
		   data-path="{{path}}"
		   data-tooltip="{{localize 'AH.COMMON.Send'}}"
		   data-index="{{index}}">
			<i class="{{ahIconClass 'message'}}"></i>
		</a>
		{{#if isCollection}}
			<a data-action="removeTrack"
			   data-id="{{id}}"
			   data-path="{{path}}"
			   data-tooltip="{{localize 'AH.COMMON.Delete'}}"
			   data-index="{{index}}">
        <i class="{{ahIconClass 'close'}}"></i>
			</a>
		{{/if}}
	</div>
{{/if}}

