{{#if attributeValues}}
  <section>
    <fieldset class="">
      <legend class="">{{localize 'AH.COMMON.Actor'}}</legend>
      <img class="profile-img flexcol" src="{{actor.img}}"
           data-edit="img" title="{{actor.name}}"
           style="height: 96px; width: auto; object-fit: contain;" />
      {{#each attributes}}
        {{ahIconBadge iconClass=@key value=(lookup @root/attributeValues @key)}}
      {{/each}}
    </fieldset>
  </section>
{{/if}}

<section>
  {{#if actors}}
    <fieldset>
      <legend>{{localize 'AH.DOCUMENT.Actor.plural'}}</legend>
      {{ahDocumentCarousel actors}}
    </fieldset>
  {{/if}}

  <div>
    {{#if label}}
      <fieldset>
        <legend>{{localize 'AH.COMMON.Label'}}</legend>
        <label>
          <input name="label" type="text" value="{{label}}">
        </label>
      </fieldset>
    {{/if}}

    {{#if increment}}
      <fieldset>
        <legend>{{localize 'AH.COMMON.Increment'}}</legend>
        <label>
          <input name="increment" type="checkbox" {{checked increment}}>
        </label>
      </fieldset>
    {{/if}}
  </div>

  <div class="ah-grid-2">
    <!-- ATTRIBUTES -->
    <fieldset>
      <legend>{{localize 'AH.CHARACTER.Attribute.plural'}}</legend>
      <div class="ah-field-group --row">
        <div class="">
          {{localize 'AH.COMMON.Primary'}}
          <div class="ah-icon__radio-group">
            {{#each attributeOptions as |attr| }}
              <label class="ah-icon --s {{icon}}"
                     data-tooltip="{{localize label}}">
                <input checked="checked" type="radio" name="primary" value="{{value}}">
              </label>
            {{/each}}
          </div>
        </div>

        <div class="">
          {{localize 'AH.COMMON.Secondary'}}
          <div class="ah-icon__radio-group">
            {{#each attributeOptions as |attr| }}
              <label class="ah-icon --s {{icon}}"
                     data-tooltip="{{localize label}}">
                <input checked="checked"
                       type="radio"
                       name="secondary"
                       value="{{value}}">
              </label>
            {{/each}}
          </div>
        </div>
      </div>
    </fieldset>

    <!-- MODIFIER -->
    <fieldset>
      <legend>{{localize 'AH.CHARACTER.Modifier.long'}}</legend>
      <div class="ah-field-group --row">
        {{ahBadge iconClass='modifier' label='AH.CHARACTER.Modifier.short' value=bonus classes="--row" }}
        <label class="ah-flex-1">
          {{localize 'AH.CHARACTER.Modifier.long'}}
          <input name="modifier" type="number" value="{{modifier}}">
        </label>
      </div>
    </fieldset>

    <!-- DIFFICULTY  -->
    {{#if (eq type 'attribute')}}
      <fieldset>
        <legend>{{localize 'AH.CHECK.DifficultyLevel.long'}}</legend>
        {{#if (eq type 'group')}}
        {{else}}
          <label>
            {{localize 'AH.CHECK.DifficultyLevel.long'}}
            <input name="difficulty" type="number" value="{{difficultyLevel}}" min="0">
          </label>
        {{/if}}
        <div class="ah-flex-row">
          <button type="button" style="background: var(--ah-color-difficulty-easy)" data-action="setDifficulty" data-value="7" data-tooltip="{{localize 'AH.CHECK.Easy'}}"><i class="icon ra ra-sheep"></i></button>
          <button type="button" style="background: var(--ah-color-difficulty-normal)" data-action="setDifficulty" data-value="10" data-tooltip="{{localize 'AH.CHECK.Normal'}}"><i class="icon ra ra-aware"></i></button>
          <button type="button" style="background: var(--ah-color-difficulty-hard)" data-action="setDifficulty" data-value="13" data-tooltip="{{localize 'AH.CHECK.Hard'}}"><i class="icon ra ra-monster-skull"></i></button>
          <button type="button" style="background: var(--ah-color-difficulty-veryHard)" data-action="setDifficulty" data-value="16" data-tooltip="{{localize 'AH.CHECK.VeryHard'}}"><i class="icon ra ra-player-despair"></i></button>
        </div>
      </fieldset>
    {{/if}}
  </div>

    {{#if (eq type 'ritual')}}
        <fieldset>
          <legend>{{localize 'AH.ACTION.Potency'}}</legend>
          <table>
            <thead>
            <tr>
              <th></th>
              <th>{{localize 'AH.ACTION.Potency'}}</th>
              <th>{{localize 'AH.CHARACTER.MindPoint.plural'}}</th>
              <th>{{localize 'AH.CHECK.DifficultyLevel.long'}}</th>
            </tr>
            </thead>
            <tbody>
            {{#each potencyOptions as |potency|}}
              <tr class="{{#if potency.selected}}selected{{/if}}"
                  data-action="updateRitual">
                <td>
                  <label>
                    <input
                      type="radio"
                      name="potency"
                      value="{{@key}}"
                      {{#if potency.selected}}checked{{/if}}
                    />
                  </label>
                </td>
                <th>{{localize potency.label}}</th>
                <td>{{potency.cost}}</td>
                <td>{{potency.difficultyLevel}}</td>
              </tr>
            {{/each}}
            </tbody>
          </table>
        </fieldset>

        <fieldset>
          <legend>{{localize 'AH.FIELD.Area'}}</legend>
          <table>
            <thead>
            <tr>
              <th></th>
              <th>{{localize 'AH.FIELD.Area'}}</th>
              <th>{{localize 'AH.FIELD.Multiplier'}}</th>
            </tr>
            </thead>

            <tbody>
            {{#each areaOptions as |area index|}}
              <tr>
                <td>
                  <label>
                    <input
                      type="radio"
                      name="area"
                      data-action="updateRitual"
                      value="{{@key}}"
                      {{#if area.selected}}checked{{/if}}/>
                  </label>
                </td>
                <th>{{localize area.label}}</th>
                <td>{{area.multiplier}}</td>
              </tr>
            {{/each}}
            </tbody>
          </table>
        </fieldset>

      <fieldset>
        <legend>
          <label>{{localize 'AH.FIELD.Cost'}}</label>
        </legend>
        <span class="ah-dialog__output" id="ritual-cost">
          {{cost}}
        </span>
      </fieldset>

      <!-- Hidden: used by the result-->
      <label><input name="difficulty" type="number" value="{{potency.difficultyLevel}}" min="0" hidden/></label>
      <label><input name="cost" type="number" value="{{cost}}" min="0" hidden/></label>
    {{/if}}
</section>
