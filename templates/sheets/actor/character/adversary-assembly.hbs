<section class="tab assembly {{tab.cssClass}}" data-tab="assembly" data-group="primary">

  <div class="ah-flex-col ah-gap-s">

    <div class="ah-field-grid">
      {{ahStringField path="system.profile.rank" value=system.profile.rank label='AH.FIELD.Rank' options=(ahFormOptions 'rank')}}
      {{#if (eq system.profile.rank 'champion')}}
        {{ahStringField path="system.profile.turns" value=system.profile.turns label='AH.FIELD.Turns' type='Number'}}
      {{/if}}
      {{ahStringField path="system.profile.role" value=system.profile.role label='AH.FIELD.Role' options=(ahFormOptions 'role')}}
      {{ahTraitsField schema=systemFields.profile.fields.pressure path='system.profile.pressure' label="AH.DAMAGE.Pressure" value=system.profile.pressure options=(ahFormOptions 'traits.pressure')}}
    </div>

    <div class="ah-grid-2">
      <fieldset>
        <legend>{{localize 'AH.ADVERSARY.Attack.plural'}} [{{assembly.attacks.current}}/{{assembly.attacks.available}}]</legend>
        <ul class="ah-list">
          {{#each assembly.attacks.entries as |item|}}
            <li>{{ahDocumentAnchor item}} {{item.name}}</li>
          {{/each}}
        </ul>
      </fieldset>

      <fieldset>
        <legend>{{localize 'AH.ADVERSARY.Ability.plural'}} [{{assembly.abilities.current}}/{{assembly.abilities.available}}]</legend>
        <ul class="ah-list">
          {{#each assembly.abilities.entries as |item|}}
            <li>{{ahDocumentAnchor item}} {{item.name}} {{#if item.system.intent}}[{{ahCapitalize item.system.intent}}]{{/if}} </li>
          {{/each}}
        </ul>
      </fieldset>
    </div>

    <fieldset>
      <legend>
        <label>
          {{localize 'AH.ADVERSARY.Intent.plural'}}
        </label>
      </legend>

      <ol class="ah-list --background ah-character__intents">
        {{#each intents as |round|}}
          <li class="ah-character__intents__round">
            <label>
              {{@index}}
            </label>
            {{#each round as |intent|}}
              <span data-tooltip="{{localize (ahLocaleKey 'intents' intent format='tooltip')}}">
              <i class="ah-icon --xs {{ahLocaleKey 'intents' intent format='icon'}}"></i>
                {{localize (ahLocaleKey 'intents' intent)}}
            </span>
            {{/each}}
          </li>
        {{/each}}
      </ol>
    </fieldset>

    <fieldset>
      <legend>{{localize 'AH.CHARACTER.Affinity.plural'}} [{{assembly.affinities.current}}{{#if assembly.affinities.pressureTriggers}}+{{assembly.affinities.pressureTriggers.length}}{{/if}}/{{assembly.affinities.available}}]</legend>
      <table class="ah-table">
        <thead>
        <tr>
          <th data-tooltip="{{localize "AH.STATUS.Modifier"}}"><i class="{{ahIconClass 'parameter'}}"></i></th>
          <th data-tooltip="{{localize "AH.CHARACTER.Affinity.long"}}"><i class="{{ahIconClass 'affinity'}}"></i></th>
          <th data-tooltip="{{localize "AH.FIELD.Type"}}"><i class="{{ahIconClass 'type'}}"></i></th>
          <th data-tooltip="{{localize "AH.FIELD.Amount"}}"><i class="{{ahIconClass 'amount'}}"></i></th>
        </tr>
        </thead>
        <tbody>
        {{#each (ahFilterFields system.affinities) as |aff key|}}
          <tr>
            <td>
              <span class="ah-flex-center ah-gap-1">
             <i class="ah-icon --xs {{ahIconClass key}}"></i> {{ahCapitalize key}}
              </span>
            </td>
            <td>
              {{ahStringField path=(ahConcat 'system.affinities.' key '.preset') value=aff.preset options=(ahFormOptions 'affinities' format='short') blank=true }}
            </td>
            <td>
              {{#unless aff.preset}}
                {{ahStringField path=(ahConcat 'system.affinities.' key '.type') value=aff.preset options=(ahFormOptions 'modifier.type' format='long') }}
              {{/unless}}
            </td>
            <td>
              {{#unless aff.preset}}
                {{ahNumberField path=(ahConcat 'system.affinities.' key '.amount') value=aff.amount }}
              {{/unless}}
            </td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </fieldset>



  </div>

</section>
