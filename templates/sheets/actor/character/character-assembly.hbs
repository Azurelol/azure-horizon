<section class="tab assembly {{tab.cssClass}}" data-tab="assembly" data-group="primary">

  <div class="ah-flex-col" style="margin-top:8px;">
    <prose-mirror name="system.profile.summary" value="{{system.profile.summary}}" toggled>
      {{{lookup enriched 'system.profile.summary'}}}
    </prose-mirror>
  </div>

  <div class="ah-grid-col-2">

    <div class="ah-flex-col">
      <fieldset>
        <legend>{{localize 'AH.ADVERSARY.Attack.plural'}} [{{assembly.attacks.current}}/{{assembly.attacks.available}}]</legend>
        <ul class="ah-list">
          {{#each assembly.attacks.entries as |item|}}
            <li>{{ahDocumentAnchor item}} {{item.name}}</li>
          {{/each}}
        </ul>
      </fieldset>

      <fieldset>
        <legend>{{localize 'AH.ADVERSARY.Ability.plural'}} [{{assembly.abilities.current}}/{{assembly.abilities.available}}]</legend>
        <ul class="ah-list">
          {{#each assembly.abilities.entries as |item|}}
            <li>{{ahDocumentAnchor item}} {{item.name}}</li>
          {{/each}}
        </ul>
      </fieldset>
    </div>

    <fieldset>
      <legend>{{localize 'AH.CHARACTER.Affinity.plural'}}</legend>
      <table>
        <thead>
        <tr>
          <th data-tooltip="{{localize "AH.CHARACTER.MODIFIER.Key"}}"><i class="{{ahIconClass 'parameter'}}"></i></th>
          <th data-tooltip="{{localize "AH.CHARACTER.Affinity.long"}}"><i class="{{ahIconClass 'parameter'}}"></i></th>
          <th data-tooltip="{{localize "AH.FIELD.Type"}}"><i class="{{ahIconClass 'type'}}"></i></th>
          <th data-tooltip="{{localize "AH.FIELD.Amount"}}"><i class="{{ahIconClass 'amount'}}"></i></th>
        </tr>
        </thead>
        <tbody>
        {{#each (ahFilterFields system.affinities) as |aff key|}}
          <tr>
            <td>
              {{ahCapitalize key}}
            </td>
            <td>
              {{ahStringField path=(ahConcat 'system.affinities.' key '.preset') value=aff.preset options=(ahFormOptions 'affinities') blank=true }}
            </td>
            <td>
              {{ahStringField path=(ahConcat 'system.affinities.' key '.type') value=aff.preset options=(ahFormOptions 'modifier.type') }}
            </td>
            <td>
              {{ahNumberField path=(ahConcat 'system.affinities.' key '.amount') value=aff.amount }}
            </td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </fieldset>

  </div>

</section>
