<header class="sheet-header ah-sheet__header {{actor.type}}">

  <div class="ah-sheet-header__row">
    {{formInput actorFields.name value=actor.name classes="ah-sheet__name"}}
    {{ahInput 'system.level' system.level size ='l' type='number' icon=(ahIconClass 'level') tooltip='AH.CHARACTER.Level.long' classes="ah-character__level" }}
  </div>

  <div class="ah-sheet-header__row ah-character__header__attributes">
    <div class="ah-sheet__group">
      {{#each system.attributes as |attribute key|}}
        {{#if ../system.assembled}}
          {{ahBadge size='sm' icon=(ahIconClass key)
                    label=(ahLocaleKey 'attributes' key format='short')
                    iconClasses='--glow'
                    value=attribute.base }}
        {{else}}
          {{ahSelector size='sm' icon=(ahIconClass key)
                       label=(ahLocaleKey 'attributes' key format='short')
                       values=@root.AH.attributeDice value=attribute.base
                       bonus=attribute.bonus
                       iconClasses='--glow'
                       path=(ahConcat 'system.attributes.' key '.base') }}
        {{/if}}
      {{/each}}
    </div>

    <div class="ah-sheet__group">
      {{ahBadge size='sm' icon=(ahIconClass 'def')
                label='AH.CHARACTER.Defense.short'
                iconClasses='--glow'
                value= system.parameters.def.current }}
      {{ahBadge size='sm' icon=(ahIconClass 'mdef')
                label='AH.CHARACTER.MagicDefense.short'
                iconClasses='--glow'
                value=system.parameters.mdef.current }}
      {{ahBadge size='sm' icon=(ahIconClass 'init')
                label='AH.CHARACTER.Initiative.short'
                iconClasses='--glow'
                value=system.parameters.init.current }}
    </div>

    {{#if (eq actorType 'hero')}}
      {{> "systems/azure-horizon/templates/sheets/actor/character/character-partial-inventory.hbs"}}
    {{/if}}
  </div>

</header>
