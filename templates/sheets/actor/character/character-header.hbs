<header class="sheet-header ah-sheet__header">
  <div class="ah-sheet-header__row">
    {{formInput actorFields.name value=actor.name classes="ah-sheet__name"}}
    {{ahInput 'system.level' system.level type='number' icon=(ahIconClass 'level') label='AH.CHARACTER.Level.short' tooltip='AH.CHARACTER.Level.long' classes="ah-character__level" }}
  </div>

  <div class="ah-sheet-header__row">
    <div class="ah-sheet__group">
      {{#each system.attributes as |attribute key|}}
        {{ahSelector icon=(ahIconClass key) label=(ahLocaleKey 'attributes' key format='short') values=@root.AH.attributeDice value=attribute.base path=(ahConcat 'system.attributes.' key '.base') }}
      {{/each}}
    </div>
    <div class="ah-sheet__group">
      {{ahBadge icon=(ahIconClass 'def') label='AH.CHARACTER.Defense.short' value=system.parameters.def.current }}
      {{ahBadge icon=(ahIconClass 'mdef') label='AH.CHARACTER.MagicDefense.short' value=system.parameters.mdef.current }}
    </div>
  </div>

  <div class="ah-sheet-header__row">
    <div class="ah-roll" data-action="performAction" data-type="attribute-check"
         data-tooltip="{{localize 'AH.CHECK.Attribute'}}">
      <i class="ah-icon --m {{ahIconClass 'attributeCheck' }} spin2win"></i>
      <label>{{localize 'AH.CHECK.Attribute'}}</label>
    </div>
  </div>
</header>
