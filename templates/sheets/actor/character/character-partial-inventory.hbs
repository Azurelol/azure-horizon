
<div class="ah-character__inventory">
  <div class="ah-character__equipment">
    <a class="ah-equipment__slot --mainHand --{{equipment.mainHand.system.rarity}} " data-tooltip="{{equipment.mainHand.name}}" data-action="swapEquipment" data-slot="mainHand">
      {{#if equipment.mainHand}}
        <img src="{{equipment.mainHand.img}}" alt="{{equipment.mainHand.name}}">
      {{else}}
        <i class="ah-icon --sm {{ahIconClass 'weaponPlaceholder'}}"></i>
      {{/if}}
    </a>

    <a class="ah-equipment__slot --armor --{{equipment.armor.system.rarity}}" data-tooltip="{{equipment.armor.name}}" data-action="swapEquipment" data-slot="armor">
      {{#if equipment.armor}}
        <img src="{{equipment.armor.img}}" alt="{{equipment.armor.name}}">
      {{else}}
          <i class="ah-icon --m {{ahIconClass 'armorPlaceholder'}}"></i>
      {{/if}}
    </a>

    <a class="ah-equipment__slot --offHand --{{equipment.offHand.system.rarity}}" data-tooltip="{{equipment.offHand.name}}" data-action="swapEquipment" data-slot="offHand">
      {{#if equipment.offHand}}
        <img src="{{equipment.offHand.img}}" alt="{{equipment.offHand.name}}">
      {{else}}
        <i class="ah-icon --sm {{ahIconClass 'weaponPlaceholder'}}"></i>
      {{/if}}
    </a>
  </div>

  <div class="ah-character__engrams">

    <div class="ah-character__engrams__container">
      <a class="ah-equipment__slot --{{equipment.accessory1.system.rarity}}" data-tooltip="{{equipment.accessory1.name}}" data-action="swapEquipment" data-slot="accessory1">
        {{#if equipment.accessory1}}
          <img src="{{equipment.accessory1.img}}" alt="{{equipment.accessory1.name}}">
        {{else}}
          <i class="ah-icon --s {{ahIconClass 'accessoryPlaceholder'}}"></i>
        {{/if}}
      </a>

      <ul class="ah-character__engrams__container__entries">
        {{#if equipment.accessory1}}
          {{#with equipment.accessory1}}
            {{#each system.slots.entries as |entry|}}
              <li>
                {{#with (ahActorItem @root.actor entry.item) as |engram|}}
                  <a class="ah-character__engrams__slot"
                     data-tooltip="{{engram.system.tooltip}}"
                     data-item-id="{{../../id}}" data-slot="engram" data-index="{{@index}}">
                    <img src="{{engram.img}}">
                  </a>
                {{else}}
                  <a class="ah-character__engrams__slot ah-character__engrams__slot--empty"
                     data-tooltip="{{localize 'AH.ACTION.Engram'}}"
                     data-item-id="{{../id}}" data-slot="engram" data-index="{{@index}}">
                    <i class="ah-icon --s {{ahIconClass 'engramPlaceholder'}}"></i>
                  </a>
                {{/with}}
              </li>
            {{/each}}
          {{/with}}
        {{/if}}
      </ul>
    </div>

    <div class="ah-character__engrams__container">
      <a class="ah-equipment__slot --{{equipment.accessory2.system.rarity}}"
         data-tooltip="{{equipment.accessory2.name}}"
         data-action="swapEquipment" data-slot="accessory2">
        {{#if equipment.accessory2}}
          <img src="{{equipment.accessory2.img}}" alt="{{equipment.accessory2.name}}">
        {{else}}
          <i class="ah-icon --s {{ahIconClass 'accessoryPlaceholder'}}"></i>
        {{/if}}
      </a>
      <ul class="ah-character__engrams__container__entries">
        {{#if equipment.accessory2}}
          {{#with equipment.accessory2}}
            {{#each system.slots.entries as |entry|}}
              <li>
                {{#with (ahActorItem @root.actor entry.item) as |engram|}}
                  <a class="ah-character__engrams__slot"
                     data-tooltip="{{engram.system.tooltip}}"
                     data-item-id="{{../../id}}" data-slot="engram" data-index="{{@index}}">
                    <img src="{{engram.img}}">
                  </a>
                {{else}}
                  <a class="ah-character__engrams__slot ah-character__engrams__slot--empty"
                     data-tooltip="{{localize 'AH.ACTION.Engram'}}"
                     data-item-id="{{../id}}" data-slot="engram" data-index="{{@index}}">
                      <i class="ah-icon --s {{ahIconClass 'engramPlaceholder'}}"></i>
                  </a>
                {{/with}}
              </li>
            {{/each}}
          {{/with}}
        {{/if}}
      </ul>
    </div>
  </div>
</div>

