{{#if (ahNotEmpty modifiers)}}
  <table class="ah-table">
    <thead>
    <tr>
      <th data-tooltip="{{localize "AH.STATUS.MODIFIER.Key"}}"><i class="{{ahIconClass 'parameter'}}"></i></th>
      <th data-tooltip="{{localize "AH.STATUS.MODIFIER.Additive"}}"><i class="{{ahIconClass 'additive'}}"></i></th>
      <th data-tooltip="{{localize "AH.STATUS.MODIFIER.Multiplicative"}}"><i class="{{ahIconClass 'multiplicative'}}"></i></th>
    </tr>
    </thead>
    <tbody>
    {{#each modifiers as |entry|}}
      {{#if (or entry.additive (ne entry.multiplicative 1))}}
        <tr>
          <td>{{localize entry.key}}</td>
          <td>{{numberFormat entry.additive decimals=0 sign=true}}</td>
          <td>{{ahPercentModifier entry.multiplicative}}</td>
        </tr>
      {{/if}}
    {{else}}
      <tr>
        <td colspan="3">{{localize "AH.COMMON.None"}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>

{{else}}
  {{ahSkeleton label='AH.SHEET.MESSAGE.NoModifiersSet' }}
{{/if}}
