<section class="tab profile {{tab.cssClass}}" data-tab="profile" data-group="primary">

  {{#if (eq actor.type 'hero')}}
    <div class="ah-field-grid">
      {{ahStringField path="system.profile.identity" value=system.profile.identity label='AH.FIELD.Identity'}}
      {{ahStringField path="system.profile.theme" value=system.profile.theme label='AH.FIELD.Theme'}}
      {{ahStringField path="system.profile.origin" value=system.profile.origin label='AH.FIELD.Origin'}}
      {{ahStringField path="system.profile.anchor" value=system.profile.anchor label='AH.FIELD.Anchor'}}
    </div>
  {{/if}}

  {{#if (eq actor.type 'adversary')}}
    <div class="ah-field-grid">
      {{ahTraitsField schema=systemFields.profile.fields.traits path='system.profile.traits' label="AH.COMMON.Traits" value=system.profile.traits options=(ahFormOptions 'traits.family')}}

      {{ahStringField path="system.profile.slug" value=system.profile.slug label='AH.DOCUMENT.Slug'}}
    </div>
  {{/if}}
  <fieldset>
    <legend>
      <label>
        {{localize 'AH.FIELD.Summary'}}
      </label>
    </legend>

    <prose-mirror name="system.profile.summary" value="{{system.profile.summary}}" toggled>
      {{{lookup enriched 'system.profile.summary'}}}
    </prose-mirror>

  </fieldset>


</section>
