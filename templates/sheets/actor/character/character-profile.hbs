<section class="tab profile {{tab.cssClass}}" data-tab="profile" data-group="primary">

  {{#if (eq actor.type 'hero')}}
    <div class="ah-field-grid">
      {{ahStringField path="system.profile.identity" value=system.profile.identity label='AH.FIELD.Identity'}}
      {{ahStringField path="system.profile.theme" value=system.profile.theme label='AH.FIELD.Theme'}}
      {{ahStringField path="system.profile.origin" value=system.profile.origin label='AH.FIELD.Origin'}}
      {{ahStringField path="system.profile.anchor" value=system.profile.anchor label='AH.FIELD.Anchor'}}
    </div>
  {{/if}}

  {{#if (eq actor.type 'adversary')}}
    <div class="ah-field-grid">
      {{ahTraitsField schema=systemFields.profile.fields.traits path='system.profile.traits' label="AH.COMMON.Traits" value=system.profile.traits options=(ahFormOptions 'traits.family')}}
      {{ahStringField path="system.profile.rank" value=system.profile.rank label='AH.FIELD.Rank' options=(ahFormOptions 'rank')}}
      {{#if (eq system.profile.rank 'champion')}}
        {{ahStringField path="system.profile.turns" value=system.profile.turns label='AH.FIELD.Turns' type='Number'}}
        {{ahBooleanField path="system.profile.villain" value=system.profile.villain label='AH.FIELD.Villain'}}
      {{/if}}
      {{ahStringField path="system.profile.role" value=system.profile.role label='AH.FIELD.Role' options=(ahFormOptions 'role')}}
      {{ahStringField path="system.profile.slug" value=system.profile.slug label='AH.DOCUMENT.Slug'}}
      {{ahTraitsField schema=systemFields.profile.fields.pressure path='system.profile.pressure' label="AH.DAMAGE.Pressure" value=system.profile.pressure options=(ahFormOptions 'traits.pressure')}}
    </div>

  <fieldset>
    <legend>
      <label>
        {{localize 'AH.ADVERSARY.Intent.plural'}}
      </label>
    </legend>

    <ol class="ah-list --background ah-character__intents">
      {{#each intents as |round|}}
        <li class="ah-character__intents__round">
          <label>
            {{@index}}
          </label>
          {{#each round as |intent|}}
            <span data-tooltip="{{localize (ahLocaleKey 'intents' intent format='tooltip')}}">
              {{localize (ahLocaleKey 'intents' intent)}}
            </span>
          {{/each}}
        </li>
      {{/each}}
    </ol>
  </fieldset>
  {{/if}}

  <fieldset>
    <legend>
      <label>
        {{localize 'AH.FIELD.Summary'}}
      </label>
    </legend>

    <prose-mirror name="system.profile.summary" value="{{system.profile.summary}}" toggled>
      {{{lookup enriched 'system.profile.summary'}}}
    </prose-mirror>

  </fieldset>


</section>
