<aside class="sheet-sidebar ah-character__sidebar {{actor.type}}">
  <div class="ah-character__sidebar__portrait">
    <img
      class="profile-img"
      src="{{actor.img}}"
      alt="{{actor.name}}"
      {{#if editable}}
      data-action="editImage"
      data-edit="img"
      {{/if}}
      data-tooltip="{{actor.name}}"
      height="100" width="100">

    {{#if (eq actorType 'adversary') }}
      <div class="ah-character__title {{system.profile.rank}}">
        <span>{{localize (ahLocaleKey 'rank' system.profile.rank)}}</span>
        <span>{{localize (ahLocaleKey 'role' system.profile.role)}}</span>
        <div class="ah-tag__group --center">
          {{#each system.profile.traits as |trait|}}
            <span class="ah-tag --transparent">{{ahCapitalize trait}}</span>
          {{/each}}
        </div>
      </div>
    {{/if}}
  </div>

  <div class="ah-character__sidebar__section">
    {{ahResourceBar 'system.resources.hp.value' system.resources.hp.value system.resources.hp.max label='AH.CHARACTER.HitPoint.short' icon=(ahIconClass 'hp') colorClass="--ah-color-hp" }}
    {{ahResourceBar 'system.resources.mp.value' system.resources.mp.value system.resources.mp.max label='AH.CHARACTER.MindPoint.short' icon=(ahIconClass 'mp') colorClass="--ah-color-mp" }}
      {{#if (eq actorType 'hero')}}
        {{ahResourceBar 'system.resources.ip.value' system.resources.ip.value system.resources.ip.max label='AH.CHARACTER.InventoryPoint.short' icon=(ahIconClass 'ip') colorClass="--ah-color-ip" }}
        <div class="ah-flex-center" style="margin-top: 8px;">
          {{ahBadge path='system.resources.tp.value' classes='--row' value=system.resources.tp.value type='number' min=0 max=system.resources.tp.max label='AH.CHARACTER.TensionPoint.long' icon=(ahIconClass 'tp') size='s'}}
          {{ahBadge path='system.resources.hp.temporary' classes='--row' value=system.resources.hp.temporary type='number' min=0 label='AH.CHARACTER.Block.long' icon=(ahIconClass 'block') size='s' }}
        </div>
      {{/if}}
    {{#if (eq actorType 'adversary')}}
      <div class="ah-flex-center" style="margin-top: 8px;">
        {{ahBadge path='system.resources.hp.temporary' classes='--row' value=system.resources.hp.temporary type='number' min=0 label='AH.CHARACTER.Block.long' icon=(ahIconClass 'block') size='s' }}
      </div>
    {{/if}}
  </div>

  {{> "systems/azure-horizon/templates/sheets/actor/character/character-partial-actions.hbs"}}

  {{#if (eq actorType 'hero')}}
    {{> "systems/azure-horizon/templates/sheets/actor/character/character-partial-inventory.hbs"}}
  {{/if}}

  <div class="ah-character__sidebar__section">
    <div class="ah-button-group">
      {{ahButton action='rest' data='type=short' size='sm' icon=(ahIconClass 'shortRest') tooltip='AH.INTERVAL.ShortRest.long'}}
      {{ahButton action='rest' data='type=long' size='sm' icon=(ahIconClass 'longRest') tooltip='AH.INTERVAL.LongRest.long'}}
        {{#if (eq actorType 'hero')}}
          {{ahButton action='rest' data='type=resupply' size='sm' icon=(ahIconClass 'resupply') tooltip='AH.INTERVAL.Resupply.long'}}
        {{/if}}
    </div>
  </div>

</aside>
