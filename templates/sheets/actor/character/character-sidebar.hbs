<aside class="sheet-sidebar ah-character__sidebar">
  <div class="ah-character__sidebar__portrait">
    <img
      class="profile-img"
      src="{{actor.img}}"
      alt="{{actor.name}}"
      {{#if editable}}
      data-action="editImage"
      data-edit="img"
      {{/if}}
      data-tooltip="{{actor.name}}"
      height="100" width="100">
  </div>

  <div class="ah-character__sidebar__section">
    {{ahResourceBar 'system.resources.hp.value' system.resources.hp.value system.resources.hp.max label='AH.CHARACTER.HitPoint.short' icon=(ahIconClass 'hp') colorClass="--ah-color-hp" }}
    {{ahResourceBar 'system.resources.mp.value' system.resources.mp.value system.resources.mp.max label='AH.CHARACTER.MindPoint.short' icon=(ahIconClass 'mp') colorClass="--ah-color-mp" }}
      {{#if (eq actorType 'hero')}}
        {{ahResourceBar 'system.resources.tp.value' system.resources.tp.value system.resources.tp.max label='AH.CHARACTER.TensionPoint.short' icon=(ahIconClass 'tp') colorClass="--ah-color-tp" }}
        {{ahResourceBar 'system.resources.ip.value' system.resources.ip.value system.resources.ip.max label='AH.CHARACTER.InventoryPoint.short' icon=(ahIconClass 'ip') colorClass="--ah-color-ip" }}
      {{/if}}
  </div>

  {{#if (eq actorType 'hero')}}
    <div class="ah-character__sidebar__section">
      <div class="ah-character__equipment">
        <a class="ah-character__equipment__slot" data-tooltip="{{equipment.mainHand.name}}" data-action="swapEquipment" data-slot="mainHand">
          {{#if equipment.mainHand}}
            <img src="{{equipment.mainHand.img}}" alt="{{equipment.mainHand.name}}">
          {{else}}
          {{/if}}
        </a>

        {{#unless (eq equipment.mainHand.system.handedness 'two')}}
          <a class="ah-character__equipment__slot" data-tooltip="{{equipment.offHand.name}}" data-action="swapEquipment" data-slot="offHand">
            {{#if equipment.offHand}}
              <img src="{{equipment.offHand.img}}" alt="{{equipment.offHand.name}}">
            {{else}}
            {{/if}}
          </a>
        {{/unless}}

        <a class="ah-character__equipment__slot" data-tooltip="{{equipment.armor.name}}" data-action="swapEquipment" data-slot="armor">
          {{#if equipment.armor}}
            <img src="{{equipment.armor.img}}" alt="{{equipment.armor.name}}">
          {{else}}
          {{/if}}
        </a>
      </div>
    </div>
  {{/if}}

  {{> "systems/azure-horizon/templates/sheets/actor/character/character-partial-actions.hbs"}}

  {{#if (eq actorType 'adversary')}}
    <div class="ah-character__sidebar__section">
      {{ahStringField path="system.profile.rank" value=system.profile.rank label='AH.FIELD.Rank' options=(ahFormOptions 'rank')}}
      {{#if (eq system.profile.rank 'champion')}}
        {{ahStringField path="system.profile.turns" value=system.profile.turns label='AH.FIELD.Turns' type='Number'}}
      {{/if}}
      {{ahStringField path="system.profile.role" value=system.profile.role label='AH.FIELD.Role' options=(ahFormOptions 'role')}}
      {{ahBooleanField path="system.profile.villain" value=system.profile.villain label='AH.FIELD.Villain'}}
    </div>
  {{/if}}

  <div class="ah-character__sidebar__section">
    <div class="ah-button-group">
      {{ahButton action='rest' data='type=short' size='sm' icon=(ahIconClass 'shortRest') tooltip='AH.INTERVAL.ShortRest.long'}}
      {{ahButton action='rest' data='type=long' size='sm' icon=(ahIconClass 'longRest') tooltip='AH.INTERVAL.LongRest.long'}}
        {{#if (eq actorType 'hero')}}
          {{ahButton action='rest' data='type=resupply' size='sm' icon=(ahIconClass 'resupply') tooltip='AH.INTERVAL.Resupply.long'}}
        {{/if}}
    </div>
  </div>

</aside>
