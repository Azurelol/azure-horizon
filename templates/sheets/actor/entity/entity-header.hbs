<header class="sheet-header ah-sheet__header {{system.kind}}">
  <div class="ah-entity__header">
    <div class="ah-entity-header__name">
      <img
        class="profile-img"
        src="{{actor.img}}"
        alt="{{actor.name}}"
        {{#if editable}}
        data-action="editImage"
        data-edit="img"
        {{/if}}
        data-tooltip="{{actor.name}}">
      {{formInput actorFields.name value=actor.name classes="ah-sheet__name"}}
      {{ahResourceBar 'system.resources.hp.value' system.resources.hp.value system.resources.hp.max label='AH.CHARACTER.HitPoint.short' icon=(ahIconClass 'hp') colorClass="--ah-color-hp" }}
      {{ahInput 'system.level' system.level size ='m' type='number' icon=(ahIconClass 'level') tooltip='AH.CHARACTER.Level.long' classes="ah-character__level" }}
    </div>

    <div class="ah-sheet-header__row">
    </div>
  </div>


</header>
