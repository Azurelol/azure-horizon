<header class="sheet-header ah-sheet__header {{system.kind}}">
  <div class="ah-entity__header">
    <div class="ah-entity-header__name">
      <img
        class="profile-img"
        src="{{actor.img}}"
        alt="{{actor.name}}"
        {{#if editable}}
        data-action="editImage"
        data-edit="img"
        {{/if}}
        data-tooltip="{{actor.name}}">
      {{formInput actorFields.name value=actor.name classes="ah-sheet__name"}}
      {{ahStringField path='system.kind' value=system.kind icon=(ahIconClass 'follower') options=(ahFormOptions 'followerTypes') classes="ah-width-50" tooltip='AH.FIELD.Kind' }}
      {{ahInput 'system.level' system.level size ='l' type='number' icon=(ahIconClass 'level') tooltip='AH.CHARACTER.Level.long' classes="ah-character__level" }}
    </div>

    <div class="ah-sheet-header__row">

      {{ahResourceBar 'system.resources.hp.value' system.resources.hp.value system.resources.hp.max label='AH.CHARACTER.HitPoint.short' icon=(ahIconClass 'hp') classes='--small' colorClass="--ah-color-hp" }}

      {{#if (eq system.kind 'guest')}}
      {{/if}}

      {{#if (eq system.kind 'companion')}}
        {{formGroup systemFields.references.fields.actor value=system.references.actor.id options=actorOptions }}
      {{/if}}

      {{ahNumberField path='system.potential' value=system.potential icon=(ahIconClass 'follower') label='AH.FOLLOWER.Potential' style='width:200px;' min=0 max=5 range=true }}
    </div>
  </div>


</header>
