<section class="tab adversaries {{tab.cssClass}}" data-tab="adversaries" data-group="primary">
  <div class="adversaries content">
    {{#unless (gt adversaries.length 0)}}
      <div class="ah-message --banner">
      <span>
        {{localize 'AH.SHEET.MESSAGE.NoDataAvailable'}}
      </span>
      </div>
    {{/unless}}

    <ul class="ah-list">
    {{#each (ahSort adversaries 'name') as |entry|}}
      <li class="ah-list__entry --s character-option {{#if this.active}}active{{/if}}"
          style="--entry-img-bg: var(--ah-adversary-background-gradient)"
           data-uuid="{{entry.uuid}}" data-type="adversary">

        <div class="ah-list__entry__left">
          <a data-action="revealAdversary"
             data-actor="{{entry.uuid}}">
            <img src="{{ entry.img }}" data-tooltip="{{ entry.name }}" />
          </a>
        </div>

        <div class="ah-list__entry__right">
          <div class="ah-list__entry__header">
              <span class="ah-list__entry__name">
                {{entry.name}}
              </span>
            <div class="ah-tags">
              <div class="ah-tag">{{localize entry.role}}</div>
              <div class="ah-tag">{{localize entry.rank}}</div>
              {{#each entry.traits as |tag|}}
                <div class="ah-tag">{{ahHumanize tag}}</div>
              {{/each}}
            </div>

            <div class="ah-flex-center ah-gap-s" data-tooltip="{{AH.ADVERSARY.AnalysisHint}}">
              <i class="ah-icon --xs {{ahIconClass 'analysis'}} "></i>
              {{entry.analysis}}
            </div>
          </div>
          <span class="ah-list__entry__description">
             {{#if this.isRevealed }}
               <i data-tooltip="FU.StudyRevealed" class="ra ra-light-bulb"></i>
             {{/if}}
            {{#if (gt this.study 0)}}
              <span data-tooltip="{{this.study}}">{{this.studyPercent}}%</span>
            {{/if}}
          </span>
        </div>
      </li>
    {{/each}}
    </ul>
  </div>
</section>
