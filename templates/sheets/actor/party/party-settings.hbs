<section class="tab settings {{tab.cssClass}}" data-tab="settings" data-group="primary">

  <!-- Header  -->
	<header class="sheet-header">
		<div>
			<img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}"
				 style="height: 52px; width: auto; object-fit: contain;" />
			<div>
				<div class="ah-sheet__name">
					<h2 class="charname" style="flex: 3;">
            <label>
              <input name="name" type="text" value="{{actor.name}}" placeholder="Name" />
            </label>
          </h2>
				</div>
			</div>
		</div>
	</header>

	<!-- Settings -->
	<main>
		<fieldset>
			<legend>
        {{localize 'AH.COMMON.Settings'}}
			</legend>
			<div>
				<div>
					<button data-action="activate"><i class="fas fa-pen-to-square icon"></i>Set Active</button>
					<button data-action="resetCodexTags"><i class="fas fa-list icon"></i>Reset Tags</button>
					<button data-action="browseUploadDirectory"><i class="fas fa-clipboard"></i>Browse Upload Directory</button>
				</div>
				{{ahArrayField array=system.codex.tags label="AH.FIELD.Tags" path="system.codex.tags" type="string" }}
			</div>
		</fieldset>
	</main>
</section>
