<section class="tab settings {{tab.cssClass}}" data-tab="settings" data-group="primary">

  <!-- Header  -->
  <header class="ah-party__header">
    <div class="ah-party__name">
      <img
        class="profile-img"
        src="{{actor.img}}"
        alt="{{actor.name}}"
        {{#if editable}}
        data-action="editImage"
        data-edit="img"
        {{/if}}
        data-tooltip="{{actor.name}}">
      {{formInput fields.name value=actor.name classes="ah-sheet__name ah-party__name"}}
      <div class="ah-button-group">
        {{ahButton action='activate' icon='fas fa-pen-to-square' label='Set Active' }}
        {{ahButton action='resetCodexTags' icon='fas fa-list' label='Reset Tags' }}
        {{ahButton action='browseUploadDirectory' icon='fas fa-clipboard' label='Browse Upload' }}
      </div>
    </div>
  </header>

	<!-- Settings -->
	<main>
    <div class="ah-grid-2">
      <div>
        {{ahArrayField array=system.codex.tags label="AH.FIELD.Tags" path="system.codex.tags" type="string" classes='--transparent' }}
      </div>
    </div>
	</main>
</section>
