<ul class="effects-list">
  {{#each effects as |section sid|}}
    <li class="effects-header flexrow draggable" data-effect-type="{{section.type}}">
      <!-- LABEL -->
      <div class="effect-label flexrow">
        {{localize section.label}}
      </div>
      <!-- PROPERTIES -->
      <div class="effect-properties" data-tooltip="{{localize "AH.COMMON.Properties"}}">
        <i class="{{ahIconClass 'properties'}}"></i>
      </div>
      <!-- ORIGIN -->
      <div class="effect-source" data-tooltip="{{localize "AH.FIELD.Origin"}}">
        <i class="{{ahIconClass 'origin'}}"></i>
      </div>
      <!-- DURATION -->
      <div class="effect-duration" data-tooltip="{{localize "EFFECT.TABS.duration"}}">
        <i class="{{ahIconClass 'duration'}}"></i>
      </div>
      <!-- CONTROLS -->
      <div class="document-controls flexrow">
        <a class="effect-controls"
           data-tooltip="{{localize "DOCUMENT.New" type=(localize "AH.Effect.Label")}}"
           data-action="createDoc" data-document-class="ActiveEffect"
          {{!-- <!-- eslint-disable-next-line @html-eslint/no-duplicate-attrs --> --}}
          {{#if (eq section.type "inactive" )}} data-disabled="true"
          {{else if (eq section.type "temporary" )}} data-duration.rounds="1" {{/if}}
           data-origin="{{@root.document.uuid}}"
           title="{{localize 'DOCUMENT.Create' type=(localize 'DOCUMENT.ActiveEffect')}}"
           data-img="icons/svg/aura.svg">
          <i class="{{ahIconClass 'add'}}"></i>
        </a>
      </div>
    </li>

    <ul class="effect-list">
      {{#each section.effects as |effect|}}
        <li class="effect flexrow draggable" data-effect-id="{{effect.id}}" data-parent-id="{{effect.parent.id}}"
            data-document-class="ActiveEffect">
          <!-- LABEL -->
          <div class="effect-label">
            <img class="effect-image" src="{{effect.img}}" alt="{{effect.name}}" height="24" width="24">
            <div class="effect-name">{{effect.name}}</div>
          </div>
          <!-- PROPERTIES -->
          <div class="effect-properties">
            {{#if effect.system.tracker.enabled}}
              {{ahTracker effect 'system.tracker' classes='--small'}}
            {{/if}}
          </div>
          <!-- ORIGIN -->
          <div class="effect-source">{{effect.sourceName}}</div>
          <!-- DURATION -->
          <div class="effect-duration">{{effect.duration.label}}</div>
          <!-- CONTROLS -->
          <div class="document-controls">
            {{#if @root.editable}}
              <a class="effect-control" data-action="toggleEffect" title="{{localize 'AH.Effect.Toggle'}}">
                <i class="fas {{#if effect.disabled}}fa-check{{else}}fa-times{{/if}}"></i>
              </a>
            {{/if}}
            <a class="effect-control" data-action="viewDoc"
               title="{{localize 'DOCUMENT.Update' type=(localize 'DOCUMENT.ActiveEffect')}}">
              <i class="fas fa-edit"></i>
            </a>
            {{#if @root.editable}}
              <a class="effect-control" data-action="deleteDoc"
                 title="{{localize 'DOCUMENT.Delete' type=(localize 'DOCUMENT.ActiveEffect')}}">
                <i class="fas fa-trash"></i>
              </a>
            {{/if}}
            {{#if effect.system.tracker.enabled}}

            {{/if}}
          </div>
        </li>
      {{/each}}
    </ul>
  {{/each}}
</ul>
