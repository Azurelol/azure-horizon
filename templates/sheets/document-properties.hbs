<section class="standard-form tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="properties">

  <div class="ah-field__settings">
    {{#each fieldsets as |field|}}
      {{#if field.optional}}
        {{ahBooleanField path=(ahConcat field.path '.enabled') icon=(ahIconClass field.name) style='compact' label=field.label value=field.value.enabled }}
      {{/if}}
    {{/each}}
  </div>

  <div class="ah-field-group">
    {{#each fieldMap.default as |entry|}}
      {{formGroup
        entry.field
        value=entry.value
        name=entry.path
        localize=true
        options=entry.field.options.options
      }}
    {{/each}}
  </div>

  {{#if propertiesTemplate}}
    {{> propertiesTemplate}}
  {{/if}}

  <div class="ah-field-grid">
    {{#each fieldsets as |field|}}
      {{#if (or (not field.optional) field.value.enabled)}}
        {{> (lookup field 'template') }}
      {{/if}}
    {{/each}}
  </div>
</section>
