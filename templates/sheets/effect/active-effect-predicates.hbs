<section class="tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <fieldset>
    <legend>
			<span>
				<span>
					<a data-action="addPredicate">
						<i class="ah-icon--xs fas fa-circle-plus"></i>
					</a>
				</span>
				<span>{{localize "AH.EFFECT.Predicate.plural"}}</span>
				<span>
					<a data-action="clearPredicates">
						<i class="ah-icon--xs fas fa-circle-trash"></i>
					</a>
				</span>
			</span>
    </legend>

    <div class="flexcol">
      {{#each system.predicates as |predicate|}}
      <details class="ah-foldout" data-rule-element="{{predicate.id}}"{{#if expanded}} open{{/if}}>
        <summary>
          <span class="ah-flex-center">
            <button class="ah-button --transparent" data-id="{{predicate.id}}" data-action="deletePredicate">
              <i class="ah-icon --xs fas fa-circle-trash"></i>
            </button>
          </span>
          <span>{{localize predicate.localization}}</span>
        </summary>

        <div class="ah-foldout__content">
          {{> (lookup (lookup (lookup predicate "schema") "model") "template") path=(concat "system.predicates." predicate.id) predicate=predicate options=../options expanded=(lookup ../expandedPredicates id)}}
        </div>
      </details>
      {{/each}}
    </div>
  </fieldset>
</section>
