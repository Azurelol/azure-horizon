<section class="tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  {{formGroup systemFields.slug value=system.slug name='system.slug' localize=true}}

  {{!-- Tracker --}}
  <fieldset>
    <legend>{{ahBooleanField label='AH.FIELD.Tracker' path='system.tracker.enabled' value=system.tracker.enabled}} </legend>
    <div class="ah-field-grid">
      {{ahStringField path='system.tracker.name' label='AH.FIELD.Name' value=system.tracker.name}}
      {{ahStringField path='system.tracker.id' label='AH.FIELD.Identifier' value=system.tracker.id}}
      {{ahStringField path='system.tracker.style' label='AH.FIELD.Style' value=system.tracker.style options=(ahFormOptions 'trackerStyles')}}
      {{ahNumberField path='system.tracker.current' label='AH.FIELD.Current' value=system.tracker.current}}
      {{ahNumberField path='system.tracker.max' label='AH.FIELD.Maximum' value=system.tracker.max}}
    </div>
  </fieldset>

	{{!-- Rule Elements --}}
	<fieldset>
		<legend>
			<span>
				<span>
					<a data-action="addRuleElement">
						<i class="ah-icon--xs fas fa-circle-plus"></i>
					</a>
				</span>
				<span>{{localize "AH.RULE.Element.plural"}}</span>
				<span>
					<a data-action="clearRuleElements">
						<i class="ah-icon--xs fas fa-circle-trash"></i>
					</a>
				</span>
			</span>
		</legend>

		<div class="flexcol">
			{{#each system.rules as |element|}}
				{{> (lookup (lookup (lookup element "schema") "model") "template") path=(concat "system.rules." element.id) element=element options=../options expanded=(lookup ../expandedRules id)}}
			{{/each}}
		</div>
	</fieldset>
</section>
