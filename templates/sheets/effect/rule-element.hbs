<details class="ah-foldout" data-rule-element="{{element.id}}"{{#if expanded}} open{{/if}}>
  <summary>
		<span class="ah-flex-center">
			<!-- Toggle Enabled -->
			{{formGroup element.schema.fields.enabled value=element.enabled name=(ahConcat path ".enabled")}}
			<!-- Delete Action -->
			<a class="" data-id="{{element.id}}" data-action="deleteRuleElement">
				<i class="ah-icon --xs fas fa-circle-trash"></i>
			</a>
		</span>
		<span>{{element.templateHeader}}</span>
	</summary>

	<div class="ah-foldout__content">
		<!-- 1. Trigger -->
		<div class="ah-rule-element__section">
			<header>
				<div>
					<span data-tooltip="{{localize 'AH.RULE.TriggerHint'}}">{{localize 'AH.RULE.Trigger.long'}}</span>
				</div>
				<!-- 1.1 Type Selector -->
				<label class="ah-field --row">
					{{~localize 'AH.COMMON.Type'}}
					<select data-action="updateRuleTrigger" data-type="{{element.trigger.type}}" data-id="{{element.id}}">
						{{selectOptions options.ruleTriggers selected=element.trigger.type localize=true}}
					</select>
				</label>
			</header>

			<div class="ah-rule-element__section__content">
				<!-- 1.2 Base Properties -->
				<label class="ah-field" data-tooltip="{{localize 'AH.FIELD.EventRelationHint'}}">
					<span>{{localize 'AH.FIELD.EventRelation'}}</span>
					<select name="{{ahConcat path ".trigger.eventRelation"}}">
						<option value="">-</option>
						{{selectOptions options.eventRelation selected=element.trigger.eventRelation localize=true}}
					</select>
				</label>

				<!-- 1.3 Derived Properties -->
				{{> (lookup (lookup (lookup element.trigger "schema") "model") "template") trigger=element.trigger path=(concat path ".trigger") options=options}}
			</div>
		</div>

		<!-- 2. Predicates -->
		<div class="ah-rule-element__section">
			<header>
				<div>
					<span data-tooltip="{{localize 'AH.RULE.PredicatesHint'}}">{{localize 'AH.RULE.Predicates'}}</span>
					<a data-action="addRulePredicate" data-id="{{element.id}}">
						<i class="fas fa-plus icon"></i>
					</a>
				</div>
			</header>

			<div class="ah-rule-element__section__content">
				{{#each element.predicates as |predicate|}}
					<div class="ah-rule-element__item">
						<header>
							<label>
								{{localize (lookup (lookup (lookup predicate "schema") "model") "localization")}}
							</label>
							<span>
								{{#if predicate.schema.fields.selector}}
									<label data-tooltip="{{localize 'AH.FIELD.SelectorHint'}}">{{localize 'AH.FIELD.Selector'}}
										<select name="{{ahConcat ../path ".predicates." predicate.id ".selector"}}">
											{{selectOptions ../options.targetSelector selected=predicate.selector localize=true}}
										</select>
									</label>
								{{/if}}
								<a data-action="removeRulePredicate" data-id="{{../element.id}}" data-predicate-id="{{predicate.id}}">
									<i class="fas fa-circle-minus"></i>
								</a>
							</span>
						</header>

						<div class="ah-rule-element__item__content">
							{{> (lookup (lookup (lookup predicate "schema") "model") "template") path=(concat ../path ".predicates." predicate.id) predicate=predicate options=../options}}
						</div>
					</div>
				{{/each}}
			</div>
		</div>

		<div class="ah-rule-element__section">

			<header>
				<div>
					<span data-tooltip="{{localize 'AH.RULE.ActionsHint'}}" >{{localize 'AH.RULE.Action.plural'}}</span>
					<a data-action="addRuleAction" data-id="{{element.id}}">
						<i class="fas fa-plus icon"></i>
					</a>
				</div>
				<!-- 3. Selector -->
				<label class="">
					<span data-tooltip="{{localize 'AH.FIELD.SelectorHint'}}">{{localize 'AH.FIELD.Selector'}}</span>
					<select name="{{ahConcat path ".selector"}}" class="resource-inputs select-dropdown-m">
						{{selectOptions options.targetSelector selected=element.selector localize=true}}
					</select>
				</label>
			</header>

			<div class="ah-rule-element__section__content">
				<!-- 4. Actions -->
				{{#each element.actions as |action|}}
					<div class="ah-rule-element__item">
						<header>
							<label>
								{{localize (lookup (lookup (lookup action "schema") "model") "localization")}}
							</label>
							<a class="" data-action="removeRuleAction" data-id="{{../element.id}}" data-action-id="{{action.id}}">
								<i class="icon fas fa-circle-minus"></i>
							</a>
						</header>
						<div class="ah-rule-element__item__content">
							{{> (lookup (lookup (lookup action "schema") "model") "template") path=(concat ../path ".actions." action.id) action=action options=../options}}
						</div>
					</div>
				{{/each}}
			</div>
		</div>
	</div>

</details>
