<label class="ah-field">
	<span>{{localize 'AH.DamageType.long'}}</span>
	<select name="{{ahConcat path ".damageType"}}">
		<option value="">-</option>
		{{selectOptions options.damageTypes selected=trigger.damageType sort=true localize=true}}
	</select>
</label>

<div class="ah-field">
	<span>{{localize 'AH.ItemGroup.long'}}</span>
	{{formGroup trigger.schema.fields.itemGroups value=trigger.itemGroups options=options.itemGroupOptions name=(ahConcat path ".itemGroups") }}
</div>

<div class="ah-field-group --row">
	<label class="ah-field">
		<span>{{localize 'AH.FIELD.ComparisonOperator'}}</span>
		<select name="{{ahConcat path ".damageThreshold.operator"}}">
			<option value="">-</option>
			{{selectOptions options.comparisonOperator selected=trigger.damageThreshold.operator sort=true localize=true}}
		</select>
	</label>

	<label class="ah-field">
		<span>{{localize 'AH.FIELD.Amount'}}</span>
		<input type="number" name="{{ahConcat path ".damageThreshold.amount"}}" value="{{ trigger.damageThreshold.amount }}" />
	</label>
</div>

