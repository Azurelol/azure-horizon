{{#> ahFieldset label='AH.FIELD.Action' icon=(ahIconClass 'action') enabled=model.enabled name=(ahConcat path ".enabled")}}
  {{ahStringField path=(ahConcat path '.type') label="AH.FIELD.Type" value=model.type blank=true classes='--flex2' options=(ahFormOptions 'actionTypes')}}
  {{#if (eq value.type 'action')}}
    {{ahStringField path=(ahConcat path '.points') label="AH.FIELD.Points" value=model.points }}
  {{/if}}
    {{ahStringField path=(ahConcat path '.range') label="AH.FIELD.Range" value=model.range blank=true options=(ahFormOptions 'traits.range')}}
    {{ahStringField path=(ahConcat path '.targeting') label="AH.FIELD.Targeting" value=model.targeting blank=true options=(ahFormOptions 'targetingRule')}}
  {{ahTraitsField schema=field.fields.traits path=(ahConcat path '.traits') label="AH.COMMON.Traits" value=model.traits options=(ahFormOptions 'traits.action')}}
{{/ahFieldset}}
