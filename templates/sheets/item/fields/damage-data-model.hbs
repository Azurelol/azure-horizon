{{#> ahOptionalFieldset label='AH.COMMON.Damage' icon=(ahIconClass 'damage') enabled=value.enabled name=(ahConcat path ".enabled")}}

  <div class="ah-field-group --row">
    {{ahStringField path=(ahConcat path '.primary.type') label="AH.COMMON.Type" value=value.primary.type options=(ahFormOptions 'damageTypes')}}
    {{ahStringField path=(ahConcat path '.primary.amount') label="AH.COMMON.Amount" value=value.primary.amount }}
  </div>

  <div class="ah-field-group --row">
    {{ahStringField path=(ahConcat path '.secondary.type') label="AH.COMMON.Type" value=value.secondary.type options=(ahFormOptions 'damageTypes')}}
    {{ahStringField path=(ahConcat path '.secondary.amount') label="AH.COMMON.Amount" value=value.secondary.amount }}
  </div>

  {{ahTraitsField schema=field.fields.traits path=(ahConcat path '.traits') label="AH.COMMON.Traits" value=value.traits options=(ahFormOptions 'traits.damage')}}
{{/ahOptionalFieldset}}
