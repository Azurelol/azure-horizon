{{#> ahOptionalFieldset label='AH.COMMON.Damage' icon=(ahIconClass 'damage') enabled=model.enabled name=(ahConcat path ".enabled")}}

  <div class="ah-field-group">
    {{ahStringField path=(ahConcat path '.primary.type') label="AH.COMMON.Primary" value=model.primary.type options=(ahFormOptions 'damageTypes')}}
    {{ahStringField path=(ahConcat path '.primary.amount') label="AH.FIELD.Bonus" value=model.primary.amount }}
  </div>

  <div class="ah-field-group">
    {{ahStringField blank=true path=(ahConcat path '.secondary.type') label="AH.COMMON.Secondary" value=model.secondary.type options=(ahFormOptions 'damageTypes')}}
    {{ahStringField path=(ahConcat path '.secondary.amount') label="AH.FIELD.Bonus" value=model.secondary.amount }}
  </div>

  {{ahTraitsField schema=field.fields.traits path=(ahConcat path '.traits') label="AH.COMMON.Traits" value=model.traits options=(ahFormOptions 'traits.damage')}}
{{/ahOptionalFieldset}}
