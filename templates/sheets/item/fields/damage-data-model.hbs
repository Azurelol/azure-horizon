{{#> ahOptionalFieldset label='AH.COMMON.Damage' icon=(ahIconClass 'damage') enabled=value.enabled name=(ahConcat path ".enabled")}}

  <div class="ah-field-group">
    {{ahStringField path=(ahConcat path '.primary.type') label="AH.COMMON.Primary" value=value.primary.type options=(ahFormOptions 'damageTypes')}}
    {{ahStringField path=(ahConcat path '.primary.amount') label="AH.FIELD.Offset" value=value.primary.amount }}
  </div>

  <div class="ah-field-group">
    {{ahStringField blank=true path=(ahConcat path '.secondary.type') label="AH.COMMON.Secondary" value=value.secondary.type options=(ahFormOptions 'damageTypes')}}
    {{ahStringField path=(ahConcat path '.secondary.amount') label="AH.FIELD.Offset" value=value.secondary.amount }}
  </div>

  {{ahStringField path=(ahConcat path '.grade') label="AH.FIELD.Grade" value=value.grade options=(ahFormOptions 'grades')}}
  {{ahTraitsField schema=field.fields.traits path=(ahConcat path '.traits') label="AH.COMMON.Traits" value=value.traits options=(ahFormOptions 'traits.damage')}}
{{/ahOptionalFieldset}}
