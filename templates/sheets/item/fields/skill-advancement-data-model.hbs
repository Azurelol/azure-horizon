<fieldset>
  <legend>
    <label>
      <i class="ah-icon --s {{ahIconClass 'skill'}}"></i>
      {{localize 'AH.ACTION.Skill'}}
    </label>
  </legend>
  <div>
    <div class="ah-field-group --row">
      {{ahStringField path=(ahConcat path '.level.current') label="AH.FIELD.Current" value=value.level.current }}
      {{ahStringField path=(ahConcat path '.level.max') label="AH.FIELD.Maximum" value=value.level.max }}
    </div>
  </div>
</fieldset>
