<fieldset>
  <legend>
    <label>
      <i class="ah-icon --s {{ahIconClass 'weapon'}}"></i>
      {{localize 'AH.FIELD.Weapon'}}
    </label>
  </legend>
  {{ahBooleanField path=(ahConcat path '.check') label="AH.COMMON.Check" value=value.check }}
  {{ahBooleanField path=(ahConcat path '.damage') label="AH.COMMON.Damage" value=value.damage }}
  {{ahStringField path=(ahConcat path '.power') label="AH.FIELD.Power" value=value.power blank=true options=(ahFormOptions 'power') }}
</fieldset>
