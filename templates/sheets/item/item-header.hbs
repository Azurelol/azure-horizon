<header class="sheet-header ah-sheet__header">
  <div class="ah-item__header">
    <img
      class="profile-img"
      src="{{item.img}}"
      alt="{{item.name}}"
      {{#if editable}}
      data-action="editImage"
      data-edit="img"
      {{/if}}
      data-tooltip="{{item.name}}"
      height="100" width="100">

    <div class="ah-item__header__properties">
      {{formInput fields.name value=item.name}}
        <div class="ah-flex-row">
          {{formGroup systemFields.revision value=system.revision localize=true}}
          {{formGroup systemFields.slug value=system.slug localize=true}}
        </div>
    </div>
  </div>
</header>
