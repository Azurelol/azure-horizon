<header class="sheet-header ah-sheet__header">
  <div class="ah-item__header">
    <div class="ah-item-header__name">
      <img
        class="profile-img"
        src="{{item.img}}"
        alt="{{item.name}}"
        {{#if editable}}
        data-action="editImage"
        data-edit="img"
        {{/if}}
        data-tooltip="{{item.name}}"
        height="100" width="100">
      {{formInput fields.name value=item.name classes="ah-sheet__name ah-item__name"}}
      {{formGroup systemFields.revision value=system.revision name='system.revision' localize=true classes='ah-item__revision'}}
      {{formGroup systemFields.slug value=system.slug name='system.slug' localize=true classes='ah-item__slug'}}
    </div>
    <div class="ah-item__header__properties">
      {{#each fieldMap.header as |entry|}}
        {{formGroup
          entry.field
          value=entry.value
          name=entry.path
          localize=true
          options=entry.field.options.options
        }}
      {{/each}}
    </div>
  </div>
</header>
