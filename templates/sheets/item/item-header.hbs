<header class="sheet-header ah-sheet__header">
  <div class="ah-item__header">
    <img
      class="profile-img"
      src="{{item.img}}"
      alt="{{item.name}}"
      {{#if editable}}
      data-action="editImage"
      data-edit="img"
      {{/if}}
      data-tooltip="{{item.name}}"
      height="100" width="100">

    <div class="ah-item__header__properties">
      {{formInput fields.name value=item.name classes="ah-sheet__name"}}
      <div class="ah-field-grid --triple">
        {{formGroup systemFields.revision value=system.revision name='system.revision' localize=true}}
        {{formGroup systemFields.slug value=system.slug name='system.slug' localize=true}}
        {{#each fieldMap.header as |entry|}}
          {{formGroup
            entry.field
            value=entry.value
            name=entry.path
            localize=true
            options=entry.field.options.options
          }}
        {{/each}}
      </div>
    </div>
  </div>
</header>
